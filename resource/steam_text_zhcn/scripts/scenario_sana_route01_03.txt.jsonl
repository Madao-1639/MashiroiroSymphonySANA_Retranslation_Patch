{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 0, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隔天。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“新吾同学，欢迎回来～”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 366, "voice": "_ag3897", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我回来了，安洁。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 3, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不，不是安洁！我是拉美～～！”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 366, "voice": "_ag3898", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁坏掉了。", "text_idx": 367, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这就是传说中的拉美～～吗。", "text_idx": 388, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然不太清楚是什么意思……", "text_idx": 385, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 7, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“顺带一提，拉美是野生女仆（Norameido）的简称喔。欸嘿，这是小知识！”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "安洁", "alt_speaker_idx": 366, "voice": "_ag3899", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明没问她自己就说明了。", "text_idx": 375, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今后都要用这个名字吗？”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 10, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的！新吾同学也把安洁改成拉美～～吧！”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 366, "voice": "_ag3900", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔、嗯，我会努力试试看……拉美～～”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然不明白理由，但有种做了很坏的事情的感觉。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "待会要把拉美～～的意思告诉樱乃才行。", "text_idx": 368, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨晚回家后一发不可收拾。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "‘葛格……拉美～～拉美～～～！’", "text_idx": 261, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这样。", "text_idx": 389, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概是很喜欢这个发音吧，明明不知道意思却在我的房间里叫个不停。", "text_idx": 363, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且还夹杂一丝喘气莫名有点性感。", "text_idx": 383, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "直接翻译的话就是“葛格……野生女仆、野生女仆！”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "太莫名其妙了。", "text_idx": 364, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 21, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉……为什么会变成这样呢……”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2912", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“辛苦了，纱凪。今天只有你一个人？”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯。学姐说下午才会来。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2913", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 24, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉……”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2914", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从我来到社团教室她已经第二次叹气了。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "盯着手机不放，脸颊还气鼓鼓的样子。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 28, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……想哭。”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2915", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "出乎意料的一句话让我愣住。", "text_idx": 358, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 31, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“感觉我就像是个不需要的小孩。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2916", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“在不在都一样，真的好无力……”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2917", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在第三次的叹气后，纱凪抚摸着挂在手机上的那个玩具戒指。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 34, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呐，新吾。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2918", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我啊，一点也不懂男人心。”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2919", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 37, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“虽然想懂，但是完全不懂……”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2920", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在严重不足的情报中，我思考了一下她很重视的那只戒指的意义。", "text_idx": 361, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她说是别人送的。", "text_idx": 365, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而她现在正因为不懂男人心而烦恼。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──恋爱的烦恼？", "text_idx": 355, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我贫瘠的想像力只能得出这一个结论。", "text_idx": 372, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“有什么我能帮上忙的事吗？”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 44, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……教我什么是男人。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2921", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“男、男人？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 46, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“至今为止，我对男人了解得太少了。但是，我觉得那样是不行的。”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2922", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“所以新吾……你可以教我什么是男人吗？”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2923", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 48, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“教我什么是真正的男人吧？”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2924", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 49, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“说了这么引人遐想的话，然后等待着你的却是……”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1617", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 50, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“一记飞踢。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1618", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“还是太大意了。”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 52, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“都被人说‘教我什么是男人’了，根本想不到下一秒会被飞踢吧。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1619", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结局彻底出乎我的意料之外。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我完全无法理解她的想法。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 55, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉，这次不是因为新吾的错。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2925", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 56, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“是说，小乾为什么要做那种事？女孩子穿着裙子不能跳起来吧。”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1620", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隼太因为帮忙学生会的事，在星期六的今天也来学校了。", "text_idx": 392, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我在社团教室被她踢飞的同时，手机收到了隼太发来的“回家路上要不要一起吃个饭？”的邮件。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 43, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为我听说男人是用拳头对话的生物嘛。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2926", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 60, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我想说如果是真正的男人，应该强到我没办法撼动分毫吧……”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2927", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 61, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“呃，虽然我觉得你搞错很多地方，怎么办啊，新吾？”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1621", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“应该用更和平的方法让她理解什么是真正的男人。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 63, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“说起来，真正的男人是什么？”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1622", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“问题就在这里。”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感觉并不是能用话语说明的事情。", "text_idx": 369, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可是用拳头对话又差太远了……", "text_idx": 359, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 67, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“对小乾来说，男人是什么样的形象？”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1623", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 68, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“在我心中的形象……很吵、立刻就用暴力、自私、展现温柔都是另有目的……”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2928", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 69, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“唔哇～这样当然会讨厌男人。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1624", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“伤脑筋。我觉得就算跟你说明，那种既存的印象也很难消除掉……”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 71, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“不过，想理解的话意外地很简单不是吗？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1625", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 72, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你有什么好点子吗？”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 73, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“那种事，只要平日里观察新吾不就好了？不需要用言语一一说明。”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1626", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“观察新吾？这样就能理解男人了吗？”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2929", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 75, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“可以可以。我心爱的小新吾会教小乾你什么是真正的男人。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1627", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……隼太，你是说认真的吗？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 77, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“怎么，你没有自信吗～？”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1628", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“至少我没有反击她飞踢的‘男人气概’。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 79, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“正是如此啊。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1629", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 80, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“小乾，今后视线一秒也不能从新吾身上移开喔！”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1630", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 81, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“毕竟人家说条条大路通新吾。”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1631", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“才没有人这么说。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看隼太的样子就知道他并没有什么好点子。", "text_idx": 379, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 84, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……我也会自己再想一下。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2930", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那样比较好。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“抱歉，隼太。占用了你学生会工作的时间……”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 87, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“别在意。下次再一起吃饭吧。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1632", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 88, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“你得加油教小乾什么是男人才行喔。”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1633", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我会努力试试。”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 90, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“喔，这才是新吾。”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1634", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "收下了他不知是激励还是调侃的话语后，我离开了教室。", "text_idx": 373, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 92, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那我也要走了。……但是，真的看着新吾就能理解男人吗？”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2931", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 93, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛。总之，我能说的只有一件事……”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1635", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 94, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“不是擅长打架的家伙才是男人。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1636", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 95, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“比如说……新吾被小乾飞踢的时候有闪吗？”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1637", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 96, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……没有。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2932", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 97, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“我想也是。因为要是闪了小乾可能会受伤。”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1638", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 98, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2933", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 99, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“而且那家伙，最后还当了小乾的肉垫对吧？”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1639", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 100, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2934", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 101, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“因为那家伙宁可做到这种程度也不让愿意小乾受伤喔。”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1640", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但是，为什么要为了我做到那样……”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2935", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 103, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“原因当然是那个啊。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1641", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 104, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“因为新吾是男人，小乾是女孩子。”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1642", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 105, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2936", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 106, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“那家伙讨厌跟人起争执，乍看之下或许会让人觉得没有男子气概……”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1643", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 107, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“不过在我看来，那家伙可是个连同性都会迷上的男子汉喔。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "隼太", "alt_speaker_idx": 391, "voice": "_ht1644", "char_id": "隼太"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 108, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你跟隼太说了什么？”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 109, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“新吾的坏话。”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2937", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 110, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我没回教室是正确的。”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 111, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2938", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "走在我身旁的纱凪停下脚步，我也停下。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "后方的教室中能听到隼太在哼歌的声音。", "text_idx": 360, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 115, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“如果是隼太的话，就算被你飞踢一定也能轻松地哼歌吧。”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 116, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……男人，都是那样吗？”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2939", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是喔。”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 118, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但是新吾……就算被我那样对待，也不会报复回来……”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2940", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 119, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那纱凪跟美羽学姐是一样的女孩子吗？”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 120, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2941", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 121, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“相同的道理，男人也有各种不同的人。所以很难用话语告诉你。”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 122, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊。男人和女人，都不是那么单纯的呢。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2942", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是说，为什么你想理解男人？”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为……”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2943", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“想治好讨厌男人的毛病？”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 126, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不是那样。硬要说的话，相反。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2944", "char_id": "紗凪"}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 127, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 374, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route01_03.txt", "scene": "*start", "row": 128, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我，想成为充满男子气概的男人──”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 381, "voice": "_sn2945", "char_id": "紗凪"}]}
