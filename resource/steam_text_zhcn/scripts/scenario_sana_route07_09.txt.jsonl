{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "２月１３日，０点１分。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "交往２个月的纪念日过去了，但纱凪还是没回来。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使如此我也不打算离开。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是不再动不动就看手表而已。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 5, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……咦？在那里的是新吾君？”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3382", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "阴暗处传来声音。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我立刻就知道了对方是谁。", "text_idx": 290, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐？”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我转头看去，果然是那个熟悉的笑容。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 11, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，果然是新吾君啊。怎么了，这种时间……”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3383", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐才是，怎么还在外面？”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 13, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，嗯。我想去社团教室看看情况，顺便小熊喵的事情……”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3384", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这么说来，是在这附近有人看到跟熊喵很像的生物。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐果然很在意。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，美羽学姐在这种时间还去社团吗？", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "相比之下，我……", "text_idx": 299, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 18, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君在做什么？……啊，那里是小纱凪的家吧？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3385", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是的。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 20, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3386", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 21, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“发生什么事了？”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3387", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算敷衍过去也会被察觉。", "text_idx": 283, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 23, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“如果新吾君不介意的话，可以说给我听吗？”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3388", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 24, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“虽然只有多一年，但毕竟我也算是人生的前辈。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3389", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐挺直背脊对我微笑。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐……”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真是不可思议的人。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是像这样跟她聊天，就感觉内心轻松了不少。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不自觉卸下一切防备。", "text_idx": 269, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊，发生了那种事。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3390", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐一直微笑着听我说话。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我老实地把一切都告诉她。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我真的很喜欢纱凪。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我才克制自己。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在的自己没有办法负起身为男人的责任，我不知道我可以多靠近纱凪，不知道这是否被允许。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 42, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说着说着，我有点激动起来。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好想听纱凪的声音。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我真的很喜欢纱凪。”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后，除了这句话以外再也说不出其他。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3391", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐踮起脚尖，温柔地摸摸我的头。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那个动作跟纱凪有一点像。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 44, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君真的很珍惜小纱凪呢。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3392", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐的笑容就像太阳一样暖洋洋的。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我点点头，握拳抵在自己胸口。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 48, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪一定也感受到了喔。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3393", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“所以新吾君没有做错什么。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3394", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐……”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐对我微笑，然后转身背对我。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个背影让我好怀念。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是纱凪尊敬的女性。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们努力追赶，只为了更靠近她一点。", "text_idx": 284, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我啊，有件事从以前就想跟小纱凪说了。”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3395", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“跟纱凪说？”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 57, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。小纱凪从以前就是对自己没有自信的女孩。”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3396", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“她总是说‘像我这样的女孩子’之类的。”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3397", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那种话我现在也很常听到。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我明白那是因为学姐就是如此巨大的存在。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 61, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“但是她错了。”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3398", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐转身看我。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪没有必要变成像我这样。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3399", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪就是小纱凪喔。所以小纱凪才会这么优秀。”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3400", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，是你教了小纱凪这件事的。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3401", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我不知道我有没有教会她这个。”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“老实说，纱凪现在也很崇拜美羽学姐。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但是。”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有一点我可以感到骄傲。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我喜欢的人是乾纱凪……她已经非常明白这点了。”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3402", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 72, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，新吾君会成为很优秀的丈夫呢。”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3403", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 73, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“当然，小纱凪也是优秀的妻子♪”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3404", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐说得就像自己的事情一样高兴。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真想让纱凪也听到她这样说。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 76, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，抱歉，这么晚了还聊了好久……”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3405", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我才是，抱歉。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 78, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“你还要在这里等小纱凪吗？”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3406", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我摇了摇头。", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今天我先回去了。毕竟我也不能忽略照顾动物们的事。”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 82, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这种时候请假也可以喔。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3407", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我觉得纱凪不会允许。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要是因为谈了恋爱就对照顾动物的事草率，那就本末倒置了。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我要分清楚界线。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，我也可以现在去一趟社团吗？”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 87, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……不，没关系。”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3408", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“对了。新吾君，明天的社团活动你可以上午就来吗？”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3409", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，好的。是跟谁换班吗？”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 90, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，因为我明天的打工是上午。”", "text_idx": 229, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3410", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“所以想请新吾君代替我去社团。”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3411", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“了解，那我明天就改成上午去。”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，谢谢你～那回去路上小心喔。”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3412", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 94, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好，学姐也是。”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我本来想陪她走到公园，但是学姐体贴地让我直接回家。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明天的社团活动跟纱凪的时间错开了。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……要快点跟她和好才行。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 98, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔～好冷好冷……总之社团教室里的动物们也确认过了……”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4991", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 99, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪，辛苦了。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3413", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 100, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊，美羽学姐……”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4992", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 101, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“你果然是来看大家的情况了。”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3414", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“果然？”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4993", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 103, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“没什么。呐，小纱凪，你知道明天是什么日子吗？”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3415", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“明天吗？呃，是情人节吧……”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4994", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 105, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，小纱凪会送巧克力给新吾君吧？”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3416", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊、不是，我……那个……”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4995", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“如果你愿意，要不要跟我一起做巧克力？”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3417", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 108, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“欸欸！跟美羽学姐吗？”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4996", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 109, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，交了男朋友的话，果然还是送亲手做的巧克力比较好吧♪”", "text_idx": 228, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3418", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 110, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但、但是……”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4997", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 111, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……而且今年也是最后一次机会跟小纱凪一起做巧克力了。”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3419", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 112, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4998", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 113, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“在家里一边聊天一边做吧……呐？”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 304, "voice": "_mu3420", "char_id": "みう"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 114, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn4999", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_09.txt", "scene": "*start", "row": 115, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐……”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 303, "voice": "_sn5000", "char_id": "紗凪"}]}
