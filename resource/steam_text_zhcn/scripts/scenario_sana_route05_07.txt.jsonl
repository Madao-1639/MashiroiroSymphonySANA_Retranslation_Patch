{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘抱歉纱凪，我们还是分手吧。’", "text_idx": 186, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 1, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘欸……’", "text_idx": 189, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4335", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘我有其他喜欢的人了。那个人也说喜欢我。’", "text_idx": 184, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 3, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘……那个人，是我认识的人？’", "text_idx": 174, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4336", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘…………’", "text_idx": 173, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 5, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘新吾君，你在跟谁说话？’", "text_idx": 188, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 266, "voice": "_mu3310", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘！？’", "text_idx": 193, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4337", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 7, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘啊，是小纱凪啊。你们在聊什么？’", "text_idx": 179, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 266, "voice": "_mu3311", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘分手的事。在跟美羽学姐交往前，我想斩断过去的关系。’", "text_idx": 178, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 9, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘这样啊。小纱凪，抱歉喔。我抢走了新吾君……’", "text_idx": 192, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 266, "voice": "_mu3312", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘不是那样，是我选择了美羽学姐。’", "text_idx": 176, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 11, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘……难道，你要跟美羽学姐交往？’", "text_idx": 175, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4338", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘对，果然美羽学姐是不同的。’", "text_idx": 181, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘怎么说呢，年长的女性真的很厉害呢。不会小孩子气，也有包容力。’", "text_idx": 183, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘她让我明白了，以前的我根本不懂什么是真正的女性。’", "text_idx": 180, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 15, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘…………’", "text_idx": 173, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4339", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 16, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘抱歉喔小纱凪。我会让新吾君幸福的……’", "text_idx": 185, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 266, "voice": "_mu3313", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘纱凪就忘了我，去寻找你的幸福吧。’", "text_idx": 191, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 18, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘等、等一下！’", "text_idx": 190, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4340", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 19, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘小纱凪也要跟别人一起幸福喔，掰掰。’", "text_idx": 182, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 266, "voice": "_mu3314", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "‘掰掰，纱凪。’", "text_idx": 187, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 21, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "‘不要、我不要那样！新吾、不要走！不要丢下我！’", "text_idx": 177, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4341", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一大早就好忧郁。", "text_idx": 226, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "做了一个好可怕的恶梦。", "text_idx": 237, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "醒来时枕头被眼泪浸湿了。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么我会如此不安呢？", "text_idx": 230, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "无法忽视美羽学姐的存在。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且满脑子都想着新吾。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？你今天从早上就很没精神。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 29, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……你怎么知道的？”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4342", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为我一直看着纱凪吧。”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 31, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4343", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明是如此珍惜我的人。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我却做那种梦，太差劲了。", "text_idx": 244, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一想到这里，我就无法直视新吾的脸。", "text_idx": 227, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“又是花心的事情？”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不是那样……可是的确是想着新吾。从早上就一直想着。”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4344", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那跟我一样呢。”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 38, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4345", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我也是从早上就一直想着纱凪。”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“根本没办法听课真是糟糕。”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾不好意思地笑了笑，握住我的手。", "text_idx": 254, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他的举动让我稍微安心了一点。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除了他，没有人能让我安心。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 44, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……新吾。”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4346", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还想更安心一点。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有话语不够，只有牵手不能满足我。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 48, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你有接吻过吗……？”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4347", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我问了新吾很大胆的事。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瞬间脸颊就像着火一样发烫。", "text_idx": 263, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看着新吾的嘴唇，我就克制不住地想像。", "text_idx": 262, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没有。”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 53, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我、我也是……没有、接吻过……”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4348", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟新吾交往前，我从没有想过跟谁接吻。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是现在。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "产生了一点点兴趣。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果初吻能被新吾夺走，应该会让我更安心吧。", "text_idx": 242, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许就不会再做那种梦了。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾的表情很认真。", "text_idx": 257, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我知道他也在想接吻这件事。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我……如果新吾想亲的话……”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4349", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为我没办法主动，所以希望由他靠近。", "text_idx": 241, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我越来越无法直视新吾的脸，胸口仿佛开了一个洞似的难以呼吸。", "text_idx": 250, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“还是先不要吧。”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 66, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4350", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“看到抖成这样的纱凪，我没办法亲吻你。”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 68, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4351", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他温柔地摸摸我的头，我觉得眼泪要滑下来了。", "text_idx": 232, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“而且。”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今天的纱凪好像不太对劲。”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4352", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“虽然可能是我想太多了。”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我什么都说不出口。", "text_idx": 224, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾大概已经看穿我的内心了。", "text_idx": 255, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他知道我不是因为喜欢才想接吻。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我是为了让自己安心才想这么做。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为了这种莫名其妙的理由牺牲仅有一次的初吻。", "text_idx": 229, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 79, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉。我说了奇怪的话呢。”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4353", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾的温柔温暖了我的内心，泪水盈满眼眶。", "text_idx": 256, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 81, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔，等等，我转过去一下。”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4354", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 83, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4355", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我突然被抱住，新吾的脸就近在咫尺。", "text_idx": 248, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我紧张地闭上眼。", "text_idx": 249, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "下定决心，抿紧嘴唇。", "text_idx": 228, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 87, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯……啊……”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4356", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "脸颊上感受到柔软的触感。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后我被揽到新吾的胸口。", "text_idx": 261, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“抱歉，很害怕吗？”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 253, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 91, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……不会。”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4357", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是脸颊上的轻吻就让我脑中一片空白。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "颤抖不知何时止住了。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是双腿没有力气站稳。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 95, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“明明只是被亲脸颊……”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 265, "voice": "_sn4358", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除此之外说不出其他感想了。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被嘴唇碰到的地方好热，触感始终没有消失。", "text_idx": 269, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果是被亲吻嘴唇的话……？", "text_idx": 243, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "光是想像就好可怕。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "早上的梦我已经忘得一干二净了。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我在新吾的怀抱中，就像在另一个梦中的世界……", "text_idx": 245, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
