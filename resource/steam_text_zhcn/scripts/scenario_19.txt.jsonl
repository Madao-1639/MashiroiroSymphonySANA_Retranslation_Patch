{"script": "scenario_19.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0553", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0354", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 2, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0284", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 3, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“大家好安静呢，小熊喵。”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0183", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 4, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜！”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0061", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 5, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“怎么了吗？爱理同学、樱乃学妹。”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0285", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊、没有，没什么特别的事……”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0554", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 7, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，其他人呢？”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0555", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 8, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥去叫隼太学长了。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0355", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“而小纱同学大概是去杀新吾同学了。”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0286", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是吗……”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0556", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 11, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "三人", "alt_speaker_idx": 388, "voice": "go038", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 12, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜？”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0062", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 13, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……仔细想想，只有我们４人很罕见呢。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0557", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊～的确是呢。”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0288", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……所以，感觉热闹不起来？”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0357", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“这、这个，虽然不太清楚……”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0289", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“难道我们感情不好──”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0358", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不对不对不对不对！”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0558", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 19, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“就是说啊。大家都是在小爱理的家念书的伙伴嘛。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0185", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 20, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“但是的确热闹不起来的感觉……”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0290", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然聊天的话题要多少有多少，不过……”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0559", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0359", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 23, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "“好像缺少了什么……”“好像缺少了什么啊……”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理／安洁", "alt_speaker_idx": 408, "voice": "go042", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 24, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“是啊，少了什么呢……少了什么呢，小熊喵？搔搔搔。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0186", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 25, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜♪呜噜、呜噜～♪”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0063", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 26, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "全员", "alt_speaker_idx": 389, "voice": "go043", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……哥哥还不来。”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0361", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 28, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“好慢喔。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0293", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 29, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“是啊，如果瓜生君在的话。”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0188", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“呃，虽然这么说，但是那家伙也不是率先出来开启话题的人啊……”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0562", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是……他在做什么呢？希望他快点来呢……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0563", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“抱歉抱歉，久等──”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“等好久了！”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0294", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 34, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这边喔～瓜生君。”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0189", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 35, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0362", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……哼。那就开始吧。”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0564", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？我来喊吗？”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那就……各位，大家辛苦了！”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 39, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "“辛苦了～～～！”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "全员", "alt_speaker_idx": 389, "voice": "go044", "char_id": "汎用"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "用自动贩卖机买来的饮料干杯。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为是纸杯所以干杯也没有好听的敲击声，不过气氛很足够了。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“哎呀～终于结束了呢。啊，喝完的话安洁再帮大家倒喔！虽然说倒但只是再跑一趟自动贩卖机而已啦～”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 47, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0296", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以最重要的考试，大家觉得考得怎么样？”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0566", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔唔！被这样问好难受。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0297", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“多亏了你，我觉得应该考得还不错。比原本预料的好。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 46, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0364", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 47, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“可是不愧是结女，真的很难呢。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "隼太", "alt_speaker_idx": 414, "voice": "ht0160", "char_id": "隼太"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都露出完成一项重大任务的表情。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "关于这一点，不分男女、不分结女或各务台──看到这个气氛我个人还挺高兴的。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不过这次莫名地考得比以前轻松的感觉呢。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0298", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 51, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“的确是……以前的话更有紧绷尖锐的气氛。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 412, "voice": "sn0104", "char_id": "紗凪"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“以前的爱理只要到了考试期间，还会散发出‘敢靠近就杀了你’的气势呢。”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "纱凪", "alt_speaker_idx": 412, "voice": "sn0105", "char_id": "紗凪"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不要再提了啦。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0567", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喔……”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“或许是因为各务台的大家来了才改变的呢。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0191", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……听她这么说我很高兴。", "text_idx": 383, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 57, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“也就是说，各务台的学生没有紧张感。”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 401, "voice": "sk0365", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是不是不是。”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“没有紧张感的只有瓜生君吧，还有椋梨君。”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0568", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔哇，被呛了！”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都笑了。", "text_idx": 392, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家，都在笑。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我也高兴得笑了出来。", "text_idx": 398, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过……我也感觉比平常更紧张喔，好的意义上。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 65, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“再紧张一点比较好。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0569", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“爱理同学是要再放松一点啦。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 395, "voice": "ag0299", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 67, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我已经很放松了。”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0570", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学像学园长那样耸了耸肩。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这种庆祝会还是第一次。”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0571", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 70, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“而且还像这样大家一起。好开心喔！”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 413, "voice": "mu0192", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 71, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～～♪”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0065", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我深吸了一口气。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看着大家。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那……再干杯一次吧！”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 1, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“为什么？”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0572", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今后也请多关照……的感觉。”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──以期中考试为分界线，告一段落的感觉。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“才不要呢。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 407, "voice": "ar0573", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没错，我感觉气氛的确变得柔和了。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
