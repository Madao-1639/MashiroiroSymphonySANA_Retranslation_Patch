{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 0, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你看到大只的熊喵了？在哪里！？”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4882", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 1, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不告诉你。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0437", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 2, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“快点说啦！是在我们家附近看到的吗？”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4883", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 3, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“你要用多少钱买情报？”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0438", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 4, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“昨天不是送你动物图鉴了吗？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4884", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 5, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“我没说希望你送。”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0439", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真是不可爱的孩子……你这样子交不到女朋友喔！”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4885", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 7, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不需要那种东西。”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0440", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这对姐弟实在很难说感情好。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "来社团教室玩的理央君带来一个意外的情报。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 10, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔唔，神秘的巨大熊喵小姐出现……”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 293, "voice": "_ag3990", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 11, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“该不会那只大熊喵就是之前天羽学姐看到的……”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 302, "voice": "_ar6611", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 12, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“有可能呢。我看到的那只小熊喵也很大……”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 307, "voice": "_mu3379", "char_id": "みう"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 13, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“那不是熊喵。是熊喵的进化型，名字是……”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0441", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 14, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“名字是？”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5385", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 15, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“樱奈。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0442", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 16, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“理央央。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5386", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 17, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "“熊二熊二。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃／理央", "alt_speaker_idx": 299, "voice": "_GO_050", "char_id": "汎用"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，不用特别演这一段。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 302, "voice": "_ar6612", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理吃醋？”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5388", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谁、谁吃醋啊！樱乃跟谁要好我都无所谓啊……”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 302, "voice": "_ar6613", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 21, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“熊二熊二，那不久后也会有熊三登场吗？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "安洁", "alt_speaker_idx": 293, "voice": "_ag3991", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 22, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不要再提名字的话题了啦。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4886", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“果然这附近有熊喵一族栖息吗？”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 295, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 24, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“如果是，那会怎么样呢？”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5389", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 25, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～？”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 301, "voice": "_pn0634", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“原来如此。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5390", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 27, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……你根本听不懂吧樱乃。”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 302, "voice": "_ar6614", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 28, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5391", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 29, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“总之，需要更多目击情报。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4887", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 30, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“说的没有错～被层层谜团包裹的熊喵小姐一族的秘密，现在就要揭开了！”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "安洁", "alt_speaker_idx": 293, "voice": "_ag3992", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“还没有要揭开吧。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 302, "voice": "_ar6615", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 32, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“身体比较大的是熊二？”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 298, "voice": "_sk5392", "char_id": "桜乃"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 33, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“还有，逃跑得很快。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0444", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这种事没有亲眼见到很难想像。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他说比熊喵大，但究竟大多少呢？", "text_idx": 292, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……虽然是小事，不过理央你也迷上动物了呢。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4888", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 37, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“还好吧。”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0445", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 38, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“又骗人。昨天明明看动物图鉴看到很晚。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4889", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 39, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，理央君将来会当我们社的社长吗？”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 307, "voice": "_mu3380", "char_id": "みう"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 40, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不可能。这种人要是当社长，其他社员会受不了退社的。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 306, "voice": "_sn4890", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“没有那种事对吧，理央君？”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 307, "voice": "_mu3381", "char_id": "みう"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 42, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“嗯，没有那种事。”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 303, "voice": "_ri0446", "char_id": "理央"}]}
{"script": "scenario_sana_route07_04.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "理央君还是一样面对美羽学姐就很老实坦率。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
