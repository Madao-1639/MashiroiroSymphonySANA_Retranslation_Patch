{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“感觉我总是请樱乃帮我选礼物。”", "text_idx": 178, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“只是我擅自跟来而已。”", "text_idx": 170, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5355", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 2, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“跟葛格一起买东西很快乐。”", "text_idx": 193, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5356", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天晚上，我回家后跟樱乃说了。", "text_idx": 211, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "圣诞节的话题。", "text_idx": 203, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "想送礼物给纱凪。", "text_idx": 208, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃一听我还没决定要送什么，就决定陪我来买。", "text_idx": 215, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“昨天跟纱凪学姐约会？”", "text_idx": 183, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5357", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，你发现了？”", "text_idx": 173, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 9, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格从早上就毛毛躁躁的。”", "text_idx": 188, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5358", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 10, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以，亲亲了吗？”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5359", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“噗！？”", "text_idx": 174, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……樱乃，你是对那种事感兴趣的人吗？”", "text_idx": 159, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“被理央央影响。”", "text_idx": 191, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5360", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这么说来，理央君的确偶尔会来我们家找樱乃玩。", "text_idx": 217, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“还没亲喔。”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 16, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这么正经回答反而不知道怎么反应。”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5361", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我该怎么回答才好？”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 18, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 158, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5362", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“变成跟妹妹练习亲亲的哥哥的剧情。”", "text_idx": 169, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5363", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“要是那样就糟糕了。”", "text_idx": 192, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“又这么正经回答。”", "text_idx": 168, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5364", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格稍微放松一点比较好。”", "text_idx": 189, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5365", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了。那就跟妹妹来练习亲亲吧～”", "text_idx": 180, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 24, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……（脸红）”", "text_idx": 161, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5366", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“等一下等一下，这种反应？”", "text_idx": 187, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格这个花心鬼。”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5367", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是正经回答还是轻佻回答，樱乃都不满意的样子。", "text_idx": 199, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呼，接下来只要等圣诞节到来就好了。”", "text_idx": 171, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“买到了好东西。”", "text_idx": 164, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5368", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟樱乃逛了许多商店，最后选了用来绑头发的白色缎带。", "text_idx": 216, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为樱乃建议能配戴在身上的东西比较好。", "text_idx": 202, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "希望纱凪会喜欢。", "text_idx": 206, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“对了，也买东西给樱乃吧。虽然有点早，但当成圣诞礼物。”", "text_idx": 176, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 34, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不需要。”", "text_idx": 163, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5369", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不用客气的说。”", "text_idx": 162, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 36, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我已经从葛格那里得到很多了。”", "text_idx": 179, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5370", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“什么？”", "text_idx": 165, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 38, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“快乐的时光。”", "text_idx": 177, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5371", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“像这样一起走路也很快乐。”", "text_idx": 167, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5372", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 40, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以，什么都不需要。”", "text_idx": 182, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5373", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃……”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近这段时间我加入社团，后来又跟纱凪交往。", "text_idx": 212, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在家里跟樱乃相处的时间变少了。", "text_idx": 204, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是樱乃还是说了这么让人开心的话。", "text_idx": 201, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃不交个男朋友吗？”", "text_idx": 185, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 46, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，不交。”", "text_idx": 172, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5374", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“今年的圣诞节跟爱理一起过。”", "text_idx": 166, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5375", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "往年，圣诞节都是家人一起过的。", "text_idx": 207, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今年没办法了有点遗憾。", "text_idx": 200, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 50, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“看到幸福的葛格，我也很幸福。”", "text_idx": 186, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5376", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这就是最棒的礼物。”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5377", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……那回去路上我请你吃东西吧。”", "text_idx": 160, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 210, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“太好了。”", "text_idx": 175, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5378", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“非常幸福。”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 214, "voice": "_sk5379", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的笑容让我涌出了动力。", "text_idx": 205, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_09.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也是，看到妹妹的笑容就觉得幸福。", "text_idx": 209, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
