{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 0, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“好久没有跟葛格一起上学了。”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5320", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你这么说也是呢。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 2, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“因为你有其他女人了。”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5321", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊。”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道怎么回应樱乃的玩笑，停下脚步。", "text_idx": 466, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟纱凪的事情我还没对樱乃说。", "text_idx": 490, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "兄妹之间应该聊这种事吗？", "text_idx": 461, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5322", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个，嗯。”", "text_idx": 448, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "趁这个机会跟樱乃说吧。", "text_idx": 488, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隐瞒也没意义。", "text_idx": 492, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“或许你从濑名同学那里听说了。”", "text_idx": 410, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“其实，我跟纱凪开始交往了。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5323", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃没有惊讶。", "text_idx": 476, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理知道了？”", "text_idx": 428, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5324", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，纱凪告诉她的。”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……不愧是爱理，绝不会泄漏秘密。”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5325", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃没听说吗？”", "text_idx": 419, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。但是我知道葛格的心意。”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5326", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 20, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“射将先射马，对吧。”", "text_idx": 399, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5327", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？那是什么意思……”", "text_idx": 421, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格，你是用玩偶收买理央央吧？”", "text_idx": 438, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5328", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是，我没有那个想法。”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "仔细想想，她会发现也是当然的。", "text_idx": 460, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且她还陪我一起选了送给理央君的生日礼物。", "text_idx": 487, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“理央央收到后高兴吗？”", "text_idx": 430, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5329", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，他好像很喜欢那个猫咪玩偶。”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 28, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“太好了。”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5330", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你陪我一起选。”", "text_idx": 441, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 30, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不用客气。”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5331", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃微笑着继续往前走。", "text_idx": 475, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那樱乃怎么想呢？我跟纱凪的事。”", "text_idx": 453, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 33, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“怎么想？”", "text_idx": 404, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5332", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就是，那个……知道我们交往觉得意外之类的？”", "text_idx": 400, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 35, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没有喔。葛格跟纱凪学姐很相配，非常配。”", "text_idx": 424, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5333", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是吗？”", "text_idx": 416, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 37, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，你们交往的事大家都知道了吗？”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5334", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没有，知道的只有濑名同学、樱乃和隼太而已。”", "text_idx": 425, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“目前对班上同学还是保密。”", "text_idx": 431, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 40, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……那种的，我喜欢。”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5335", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那种的？”", "text_idx": 454, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“无法对别人说的秘密关系。”", "text_idx": 413, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5336", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 43, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“有点憧憬。”", "text_idx": 418, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5337", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过我觉得，告诉大家后能受到祝福的关系才是最棒的。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 45, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5338", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 46, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“也对。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5339", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那样的关系最好了。”", "text_idx": 452, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5340", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“咦？樱乃，你不去自己的教室吗？”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我有话跟爱理说。”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5341", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这样啊。濑名同学不知道来了没有……”", "text_idx": 445, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们走进教室。", "text_idx": 467, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“渣～虫～♪”", "text_idx": 427, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4218", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“什么！？”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪笑容满面地冲过来，抓住我的手臂带我离开教室。", "text_idx": 483, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……哥哥，真的有打算保密吗？”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5342", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“刚才的就当作没听到吧。”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“怎、怎么了？我做了什么不对的事吗？”", "text_idx": 402, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4219", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“与其说不对，应该说你为什么要那么开心地喊渣虫呢？”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那样就算保密我们的关系也没有意义。”", "text_idx": 451, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 60, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……有那么开心吗我？”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4220", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么样，樱乃？”", "text_idx": 405, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 62, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“太明显了。”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5343", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 63, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔啊，真的吗！？是说，小樱乃也已经知道我们的事了？”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4221", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。今天早上我告诉樱乃的。”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 65, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊，感觉有点羞耻呢。”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4222", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 66, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥就拜托你了，姐姐。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5344", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 67, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“姐、姐姐？”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4223", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，那个称呼还太早了。”", "text_idx": 420, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 69, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不好意思我是心直口快的妹妹。”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5345", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 70, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不，没关系！被叫姐姐真好呢！”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4224", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……纱凪，你真的有想隐瞒我们的关系吗？”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊，对喔！那个，新吾是渣虫、新吾是渣虫……”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4225", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我觉得没必要这么坚持那个称呼。”", "text_idx": 409, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 74, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥是无药可救的渣虫呢。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5346", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这种感觉？”", "text_idx": 446, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5347", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……小樱乃太厉害了。”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4226", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这种时候哥哥应该摆出什么表情？”", "text_idx": 447, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 78, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“高兴一点。”", "text_idx": 455, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 474, "voice": "_sk5348", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我有点无法认同。", "text_idx": 470, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 80, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不准看我，渣虫。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0353", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 81, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喔喔，这就是正牌的渣虫……！”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4227", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这不是该赞叹的地方吧。”", "text_idx": 444, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放学后，理央君来社团教室玩。", "text_idx": 471, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 84, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“美羽美羽，可以喂熊喵罐头吗？”", "text_idx": 437, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0354", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 85, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。那就麻烦你啰？”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3298", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 86, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“谢谢，熊喵过来。”", "text_idx": 442, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0355", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 87, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 477, "voice": "_pn0614", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，小熊喵跟理央君变得很要好呢。”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3299", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 89, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“感觉比跟我还好，有点复杂……”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4228", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 90, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为熊喵是母的，所以喜欢男人吗？”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4229", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 91, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“个人品行的问题。”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0356", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 92, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜♪”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 477, "voice": "_pn0615", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“理央君，开罐头的时候要小心别割到手指喔。”", "text_idx": 429, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3300", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 94, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“没问题的，这种小事……”", "text_idx": 426, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0357", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 95, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“唔啊！？”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0358", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 96, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“笨蛋，在做什么啊你！”", "text_idx": 433, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4230", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "罐头从理央君手中滑落，撒了满地。", "text_idx": 485, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "应该是他拉开盖子的时候太用力了。", "text_idx": 465, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没事吧理央君？”", "text_idx": 422, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 100, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“有没有受伤？”", "text_idx": 417, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3301", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 101, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“……没有。但是，对不起。”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "理央", "alt_speaker_idx": 478, "voice": "_ri0359", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 102, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“没关系，不用在意喔。我也经常会开失败呢～”", "text_idx": 423, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3302", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐面带微笑摸摸理央君的头，然后开始清理地面。", "text_idx": 464, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，我来清吧。”", "text_idx": 435, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4231", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 105, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，这边不要紧了。小纱凪也不要凶理央君喔。”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 486, "voice": "_mu3303", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4232", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在对话时纱凪的表情始终很凝重。", "text_idx": 462, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 108, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……对不起，我去做外面的作业。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4233", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我也去。”", "text_idx": 450, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不能放着她不管，我追在纱凪身后。", "text_idx": 459, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 111, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4234", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“要从什么先开始呢？”", "text_idx": 440, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我故意自言自语，看了看附近的兔子小屋。", "text_idx": 468, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这是为了营造让纱凪比较容易开口说话的气氛。", "text_idx": 491, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 115, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你是追着我来的吗？”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4235", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 116, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“表面上是来做外面的工作而已。”", "text_idx": 439, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 117, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……谢谢你。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4236", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你在想什么呢？”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 119, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4237", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪垂下头，很明显地情绪低落。", "text_idx": 482, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 121, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉，果然是美羽学姐……”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4238", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐？”", "text_idx": 436, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 123, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯。最近，理央在家里都只聊美羽学姐的事情……”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4239", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“感觉弟弟好像被抢走了。”", "text_idx": 406, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4240", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 125, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪露出一个复杂的笑容，转身背对我。", "text_idx": 484, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 126, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……要不了多久，连新吾也会。”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4241", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 127, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 128, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“才怪♪刚才是开玩笑的啦！”", "text_idx": 412, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4242", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道。”", "text_idx": 408, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我明白纱凪立刻就否认的心情，所以没有再追问。", "text_idx": 469, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 131, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉，就快到圣诞节了……”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4243", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 132, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不愧是师走月，１２月过得好快啊。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4244", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 133, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪主动改变话题，站到我身旁。", "text_idx": 481, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 134, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟刚才不同，她的笑容自然多了。", "text_idx": 489, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“给理央君的礼物买好了吗？”", "text_idx": 434, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 136, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“还没。我每年都很烦恼圣诞礼物……”", "text_idx": 443, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4245", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 137, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那今年一起去买吧？”", "text_idx": 449, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 138, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真的？你要陪我去买礼物吗？”", "text_idx": 432, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4246", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“当然了。以理央君的年龄，他一定很期待圣诞老人的到来吧。”", "text_idx": 401, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 140, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔……关于这个，那孩子不相信有圣诞老人。”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4247", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 141, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“明明是小孩却没有梦想，或者说很现实……”", "text_idx": 415, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4248", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 142, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“既然如此，今年我来当圣诞老人。”", "text_idx": 414, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“所以这次放假我们一起去买礼物吧。”", "text_idx": 411, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 144, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……对喔，也有礼物这一招。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4249", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 472, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 146, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“仔细想想，小孩子的心可以用钱买到呢。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4250", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 147, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“今年就买个豪华的礼物，期待一下他变得超～级喜欢姐姐吧！”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4251", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 148, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呵呵呵，我要买个甚至塞不进袜子里的厉害礼物～♪”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 480, "voice": "_sn4252", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好吧，能看到她打起精神最重要。", "text_idx": 463, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……小孩子的心能不能用钱买到我就不敢肯定了。", "text_idx": 456, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
