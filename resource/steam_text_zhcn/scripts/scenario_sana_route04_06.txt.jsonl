{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 0, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "期末考最后一天。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我真是没用的女人。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 2, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“纱凪，收考卷了喔？”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6528", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 3, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4015", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“欸？心情这么差！？”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6529", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "收走我桌上考卷的爱理看着我瞪大了眼睛。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“怎、怎么了、这是……纱凪？”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6530", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 7, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好想消失。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4016", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 8, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“等、等一下，冷静下来。总之，这个……是什么？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6531", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“喜欢喜欢喜欢喜欢喜欢喜欢喜欢喜欢……”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6532", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 10, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好了啦你快点收走啦！”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4017", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 11, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是这个……就这样收走没关系吗？背面写得满满的……”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6533", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在考试时我也一直想着新吾。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且越想想搞不懂。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我，到底是从什么时候喜欢上新吾的呢？", "text_idx": 293, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一定是从很久之前。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被公主抱的时候？", "text_idx": 342, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不，更早之前。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也就是说。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 19, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“到底喜欢到什么程度啊我……”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4018", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我抱头苦恼。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在考卷背面不留一丝空隙写满了“喜欢”。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我就是这么喜欢新吾吧。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 23, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“总、总之放学后聊一下吧？”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6534", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 24, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我实在有点担心你，应该说不能放着不管……”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6535", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对我来说无异于伸出援手。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想找人倾诉这份心意。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且希望有人能阻止。", "text_idx": 339, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那种家伙，喜欢上他只会变得不幸而已。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 29, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……嘿，看你幸福我就放心了。”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6536", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 30, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不是吧，这么简单就接受？”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4019", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“因为之前也听你说过类似的事情了嘛。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6537", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有这么明事理的朋友不知道是好还是不好。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理听了我的“恋爱”故事后一点也不惊讶。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是像那样写满了喜欢喜欢，你真的是为瓜生君神魂颠倒呢。”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6538", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 35, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“神、神魂颠倒什么的……那家伙很温柔，而且也有男子气概的一面，笑容也很爽朗，在紧要关头也很可靠……”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 50, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4020", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以这就叫神魂颠倒喔。”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6539", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 37, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。神魂颠倒呢。”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4021", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我又抱头苦恼。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感觉脸好烫。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对别人诉说这种心情让我真的好想消失。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以，什么时候要告白？”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6540", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 42, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“告、告白？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4022", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“喜欢到这种程度就没什么好犹豫的了。要是再忍耐好像连笔记本都会写满好可怕。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6541", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 44, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4023", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我无法反驳。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其实昨天已经在家里快写满两页了。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "再不想想办法我可能连在社团教室都无法直视他的脸。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 48, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“该不会之前说的那个你已经理解了？”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6542", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 49, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那个？”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4024", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 50, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“就是班上的女生说的……想要瓜生君的小宝宝的话题。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6543", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 51, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“还、还不到那种程度啦！”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4025", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 52, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“太好了，还不到那种程度啊。”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6544", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“要是纱凪说出想要瓜生君的小宝宝，我真的会很震惊。”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6545", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 54, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“虽、虽然将来是想要啦！”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4026", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 55, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……想生很多新吾的小宝宝。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4027", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 56, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6546", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那、那也是将来的事嘛！不是现在立刻……”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4028", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 58, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但是问我想要还是不想要的话是想要的，如果新吾叫我生，那我会说好……”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4029", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我明白了，很明白了。总之你就是喜欢瓜生喜欢到不行了。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6547", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 60, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不用摆出那么受不了的表情吧……”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4030", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 61, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你的撒糖恋爱话题。但是既然这么喜欢，那就传达心意比较好吧？”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6548", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 62, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不然事情好像会变得很复杂。”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6549", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 63, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“很复杂？”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4031", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 64, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“因为那个人太会看人脸色了。纱凪这个态度，绝对会让他想太多。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6550", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 65, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4032", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理说的对。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那家伙很敏锐，迟早会注意到我的心意。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果我们的关系因此变得尴尬……", "text_idx": 307, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 69, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……好，我决定了。”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4033", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 70, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“明天就跟新吾告白。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4034", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "刚好新吾也说有重要的话。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也做好觉悟吧。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后……", "text_idx": 333, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呐，爱理。你觉得小宝宝生出来后要取什么名字比较好？”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 338, "voice": "_sn4035", "char_id": "紗凪"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……谁知道啊那种事。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "_ar6551", "char_id": "愛理"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我真的是没用的女人。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 77, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“好久没跟葛格一起回家了。”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5311", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这么说来好像是呢。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "期末考最后一天顺利结束，我放学后陪樱乃去买东西。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然我本来是想去找纱凪。", "text_idx": 341, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明天再说吧。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 82, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“对了，跟葛格说一个情报。”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5312", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，什么情报？”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 84, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“你知道明天是什么日子吗？”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5313", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“明天？”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "１２月１１日，星期五。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想不起来是什么纪念日。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 88, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“明天是什么特别的日子吗？”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，其实……”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5314", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃踮起脚尖靠近我的耳朵。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“明天是理央央的生日。”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5315", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃的呼吸吹拂到耳朵。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这样啊……是说，这种事情不需要说悄悄话吧？”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 94, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“心情的问题。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5316", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃心满意足地微笑。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过，原来如此啊，是理央君的生日……”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 97, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“买礼物给他吧？”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5317", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“也对，就这么做吧。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "拿这件事当借口或许有点卑鄙。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是明天我想把我的心意传达给纱凪。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从出生以来第一次的告白。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管结果是什么，我都不想后悔。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我也买点什么给樱乃吧，玩偶之类的。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 104, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不需要，我没有什么想要的。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5318", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“真是个省钱的孩子呢。”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 106, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“可以当好老婆。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 329, "voice": "_sk5319", "char_id": "桜乃"}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，这我能保证。”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是我跟樱乃一起前往各务台商场。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route04_06.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "买了一个白色的猫咪玩偶准备送给理央君。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
