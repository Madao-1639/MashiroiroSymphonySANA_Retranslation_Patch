{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 0, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……好！”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4744", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从很早之前就决定了。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟新吾交往１个月后。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "等我已经有了身为女朋友的自信后。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我要对美羽学姐坦白。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其实从一开始我就知道了。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这只是我一个人的纠结。", "text_idx": 349, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "以美羽学姐的个性，不管什么时候说她都会笑着祝福我。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我也明白了一件事。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐被新吾吸引了。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一起去买那家伙的钥匙圈，跟学姐在社团教室待到很晚的时候。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐总是担心新吾。", "text_idx": 341, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明以前都没有聊过男生的话题。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们之间的聊天总是围绕着新吾。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 14, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4745", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我跟新吾还有学姐同款的钥匙圈。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是我的宝物。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第一次喜欢上的男性。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还有尊敬的学姐，身为女人我憧憬的女性。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明都是我很重要的人。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我却不希望新吾靠近学姐。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "连现在也在害怕。", "text_idx": 350, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要是美羽学姐真的喜欢上新吾，我根本没有胜算。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身为女人我没有任何赢过学姐的地方……", "text_idx": 347, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 24, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，辛苦了。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4746", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 25, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，小纱凪辛苦了～”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3354", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有一点，我不会输给学姐。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天，我对新吾诉说了自己的真心话。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也在他的胸口哭了。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，最后还是一起庆祝了纪念日。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他说我的料理很好吃。", "text_idx": 290, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我产生了自信。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有这点，即使是对学姐──", "text_idx": 299, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 34, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那个，我有重要的事要跟学姐说。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4747", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 35, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“重要的事？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3355", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“对，其实从以前我就想说了……但是说不出口……”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4748", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我笔直地看着学姐。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 38, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，是什么事？”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3356", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐的笑容跟往常一样。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我握紧手中的钥匙圈。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 41, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那个，我……”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4749", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 42, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3357", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾昨天说要跟我一起来。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我说我要一个人去。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "用自己的双脚站在学姐面前，用自己的嘴巴告诉她。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 46, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……其实我有喜欢的人了。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4750", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“现在，我跟那个人在交往。”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4751", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 48, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3358", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐没有惊讶，而是温柔地看着我。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……果然赢不了这个人啊。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是外表还是性格都是我的理想。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟去是的妈妈一样的笑容。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我明白理央为什么这么亲近她。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我也有不输学姐的地方。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为有这个强项，所以我能笔直地面对学姐。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 56, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我跟新吾交往了。”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4752", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这件事一直瞒着学姐。连爱理他们都知道了，只对学姐……”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4753", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……只对我保密啊。”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3359", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4754", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──学姐对新吾是怎么想的呢？", "text_idx": 282, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想问。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明害怕，还是想知道。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“但是。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3360", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐摸了摸我的头，然后轻轻抱住我。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“终于来跟我说了呢。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3361", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 66, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“终于？”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4755", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3362", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 68, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“大家都可以进来了喔。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3363", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 69, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4756", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的话声刚落，社团教室的门开了。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 71, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“抱歉。我没想要偷听的……”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 333, "voice": "_ar6603", "char_id": "愛理"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 72, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“社团教室前大塞车，安洁还在想发生了什么事！”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安洁", "alt_speaker_idx": 306, "voice": "_ag3985", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 73, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“要庆祝吗？”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 330, "voice": "_sk5383", "char_id": "桜乃"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 74, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 332, "voice": "_pn0633", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 75, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那安洁来准备美味的红茶喔！”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 306, "voice": "_ag3986", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊、等一下！这是怎么回事……？”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4757", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后进来的是新吾，他不好意思地抓了抓头。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐好像从以前就知道我们的事了。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 319, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 79, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“知道了？欸欸！？是、是这样吗学姐？”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4758", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 80, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，去年就知道了。”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3364", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 81, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那为什么装做不知道……”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4759", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在脑袋一片混乱的我面前，美羽学姐的笑容依然跟平常一样。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 83, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“因为这么重要的事情，我想听小纱凪亲口说……”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3365", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 84, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4760", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 85, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“因为我跟小纱凪这么要好不是吗？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3366", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 86, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4761", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 87, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐……”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4762", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明大家都在我却控制不住眼泪。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我知道不管怎么擦都擦不完，所以至少克制哭声。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 90, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“遇到这么棒的人真的太好了呢，小纱凪。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3367", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这样就可以大家一起祝福小纱凪了呢。”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3368", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 92, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……美羽学姐……美羽学姐……”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4763", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……可以不用忍耐了喔？”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3369", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 94, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“大家，要为小纱凪加油喔？”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 340, "voice": "_mu3370", "char_id": "みう"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 95, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好了好了，在祝福的时候不要掉泪嘛。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 333, "voice": "_ar6604", "char_id": "愛理"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 96, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“来吧来吧，新吾同学也不要客气站到小纱同学身边！”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 306, "voice": "_ag3987", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 97, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“今晚吃红豆泛饭。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 330, "voice": "_sk5384", "char_id": "桜乃"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……大家，谢谢你们。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 319, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾就站在我身旁，拍了拍我的头。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后握住我的手。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也回握他。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“谢谢。”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 339, "voice": "_sn4764", "char_id": "紗凪"}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "眼泪停不下来，但脸上绽放出笑容。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我可以待在这个人的身边。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟新吾交往的１个月又１天。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route06_11.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许我们终于在真正的意义上交往了。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
