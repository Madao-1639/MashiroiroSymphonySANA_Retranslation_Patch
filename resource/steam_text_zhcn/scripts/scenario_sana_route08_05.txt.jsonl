{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 0, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“真的能当社长吗？”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0570", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 1, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“可以！……我觉得。”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5215", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 2, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“明明胸部比美羽美羽小？”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0571", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 3, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“跟、跟那个没关系吧！”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5216", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 4, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“而且新吾喜欢我这个小的就好了！”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "sn7544", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喜欢归喜欢，不需要在这里说吧。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不用在意那种小事啦。”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "sn7545", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们三人在假日出门买东西。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪说她不会再打扮成男生了。", "text_idx": 341, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她开心地说因为已经不需要了。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 10, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“像这样三个人牵着手走路，就像一家人不是吗？”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5218", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "理央在中间，我跟纱凪在两边牵着他。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这么一说的确看起来像个小家庭。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 13, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“新吾是爸爸。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0572", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 15, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“妈妈死了。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0573", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 16, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“新吾是爸爸的话我就是妈妈吧！不要随便把我杀死！”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5219", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 17, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“……就算妈妈不在也不寂寞。”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0574", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 18, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不在也没关系。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0575", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 19, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5220", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "理央君说的是他真正的母亲吧。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 21, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为就算妈妈不在，也有温柔的姐姐对吧～？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5221", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 22, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“虽然胸部小。”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0576", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“就说跟胸部没有关系了啦！”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5222", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我喜欢娇小的纱凪的胸部。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 25, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不用一直强调小没有关系！”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5223", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 26, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“新吾也给我记住！待会要贴上去让你好好感受一下。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5224", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 27, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“最差劲的社长。”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0577", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“让人困扰的社长呢。”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 29, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真是的，你们男生自己就联合战线了……”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5225", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "两个男生对一个女孩子，显然无法势均力敌。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "理央君也正好是不好意思对纱凪撒娇的年纪。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“仔细想想，我是社长新吾是副社长，那就是我地位比较高吧？”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5226", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是这样没错。”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 34, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“哼嗯，所以我的命令是绝对的……”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5227", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 35, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“又在想乱七八糟的事。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0578", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“吵死了～妄想一下又不用钱有什么关系！”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5228", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你在妄想什么？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 38, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那、那么羞耻的事说不出口啦。”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5229", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……在纱凪的妄想中，她对我下了什么命令呢？", "text_idx": 310, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我有点害怕去想像。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 41, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“……那种社长没问题吗？”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0579", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃这个，嗯。我想说今后要一起加油。”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 43, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“欸，要加油吗？等一下，突然那样，讨厌……”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5230", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪还沉浸在她的妄想世界。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好像又对我下了什么命令。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 46, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“好吧，祝你们幸福。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0580", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 47, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“咦？怎么了？”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "理央君放开我们的手，一个人先往前走了。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 49, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“我腻了要回家。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0581", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“腻了？可是什么都还没有买啊。你不是想要动物的书吗？”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5231", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 51, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“哪有。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0582", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然语气冷淡，但我听起来莫名觉得亲近。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "亲近？", "text_idx": 314, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……啊，对了。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 55, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“我是会看气氛的男人。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0583", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 56, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“将来，要成为像新吾一样的男人。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0584", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“像、像新吾一样……”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5232", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“真伤脑筋啊。”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……不是我说的，好像是他自己立下的志向。”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5233", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我说不出叫他不要变得像我一样，而且觉得很不好意思。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪则是在一旁很满意地笑。", "text_idx": 338, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呐，理央。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5234", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 63, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“干嘛？”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0585", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪喊了他的名字后黏到我的身边。", "text_idx": 339, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 65, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你啊。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5235", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 66, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“也要成为好男人喔！”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5236", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 67, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这不是社长而是姐姐的命令。”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5237", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使听到她这么说，理央君仍是一如既往的冷淡表情。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 69, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“……你也是。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0586", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后露出一个跟纱凪非常像的笑容。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 71, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“姐姐也要成为好女人喔。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "理央", "alt_speaker_idx": 331, "voice": "_ri0587", "char_id": "理央"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯，这样就好了。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5238", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "上午约会，下午照顾动物。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪被选为社长后越来越努力了。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 75, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“已经很晚了，差不多该回家了。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯……但是这样好吗？我们这样。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5239", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么样？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 78, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“就是根本没时间好好约会，新吾不介意吗？跟我交往你开心吗？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5240", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们跟路上那些时髦的情侣不同。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要清扫动物们的窝和厕所，常常弄得灰头土脸。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这就是我们的日常。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“很幸福喔。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是问我开不开心，但我这样回答。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除此之外，我想不到其他形容。", "text_idx": 350, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 85, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我也很幸福……我们一样呢。”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "sn7546", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，一样。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以这样就好。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们可以一直这样走下去。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 89, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好～接下来也要尽情使用社长命令啰～”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5242", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“可以是可以，但是禁止滥用职权喔。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 91, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我才不会那样呢。总之，现在在这里强硬地亲吻我。”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5243", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“滥用得很彻底呢。还有，为什么要强硬？”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 93, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“个人的喜好。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5244", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们家的社长真是让人伤脑筋。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“社长的命令是绝对的？”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 96, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯，绝对。”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5245", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那就没办法了。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我跟纱凪面对面，搂住她的肩膀。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 99, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5246", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "闭着眼等待的纱凪好可爱，我突然想就维持这样的姿势。", "text_idx": 349, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 101, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呐，还没吗～？”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5247", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“还没～”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我捂住自己的嘴以免笑出来。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……结果你根本没有要亲我嘛！为什么把我在等待接吻的状态下放置啊？”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5248", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，个人的喜好？”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喜好是放置，到底是怎样的男朋友啊你！”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 337, "voice": "_sn5249", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然这种“喜好”不一样。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但相同的地方也有很多。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且今后还会增加得更多。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_05.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "两个人一起发现更多幸福吧。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
