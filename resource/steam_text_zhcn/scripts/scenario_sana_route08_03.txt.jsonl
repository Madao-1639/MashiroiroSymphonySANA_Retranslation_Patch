{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 65, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "‘但是，不是所有人都那样。’", "text_idx": 298, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0566", "char_id": "理央"}]}
