{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 0, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜噜噜噜噜～！”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0642", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 1, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那是怎么了？熊喵非常高兴的样子耶！”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5182", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，不知道从哪里捡来的这颗球。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "熊喵开心地推着小小的圆球在外面跑来跑去。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看得出来它真的很喜欢，我们一靠近它就会把球藏在肚子下面保护。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 5, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“我送给熊喵的。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0553", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嘿～理央居然也这么机灵啊。”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5183", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 7, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“新吾，夸奖我。”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0554", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊哈哈，理央君很棒喔。”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 9, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“……被夸奖了。”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0555", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 10, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好～棒好棒好棒好棒好棒，理央好厉害喔～”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5184", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 11, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不要碰我，丑八怪。”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0556", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 12, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“为什么我夸你你不开心？”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5185", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 13, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“动物跟小孩都很老实。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0557", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 14, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……你应该不会因为对女人没兴趣，结果就走到奇怪的歪路上去吧？”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5186", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 15, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“会这样理解的人也只有万智了，社会上一般人──”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5187", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 16, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“新吾，背我。”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0558", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好啊。”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 18, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喂喂喂！我话还没说完你们不要在那边亲亲热热！”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5188", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们被气冲冲的纱凪追着打。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "后来连熊喵也一起加入逃跑的行列，在我们脚边绕来绕去。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“来吧，熊喵也要一起玩吗～？”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 22, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜～♪”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0643", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊啊真是的，连跟熊喵都亲亲热热……”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5189", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 24, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“已经不被爱了吧？”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0559", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 25, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“当、当然还是被爱着了……应该说只有爱……”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5190", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 26, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“烦死了。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0560", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“来吧，纱凪要不要也一起玩？”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 28, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔、嗯……被玩。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5191", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 29, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜、呜咕～♪”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0644", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "加上纱凪，熊喵跑得更欢快了。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但是，迟迟找不到传闻的熊喵一族呢。”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯，可以的话希望在美羽学姐毕业前……”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5192", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 33, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0561", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 34, "speaker": "子ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜？噜噜！”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "小熊喵？", "alt_speaker_idx": 374, "voice": "_kp0001", "char_id": "子ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 35, "speaker": "子ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～！”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "小熊喵？", "alt_speaker_idx": 374, "voice": "_kp0002", "char_id": "子ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 36, "speaker": "母ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“……噜。”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵？", "alt_speaker_idx": 383, "voice": "_mp0025", "char_id": "母ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 37, "speaker": "子ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜、噜！”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "小熊喵？", "alt_speaker_idx": 374, "voice": "_kp0003", "char_id": "子ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 38, "speaker": "母ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵？", "alt_speaker_idx": 383, "voice": "_mp0026", "char_id": "母ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 39, "speaker": "子ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜？”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "小熊喵？", "alt_speaker_idx": 374, "voice": "_kp0004", "char_id": "子ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，小熊喵，那颗球怎么了？”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 389, "voice": "_mu3434", "char_id": "みう"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 41, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0645", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 42, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊，美羽学姐辛苦了～♪”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5193", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 43, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，辛苦了～是小纱凪送球给小熊喵的吗？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 389, "voice": "_mu3435", "char_id": "みう"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 44, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“是我给的。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0562", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，这样啊。谢谢你喔，理央君，乖孩子乖孩子～”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 389, "voice": "_mu3436", "char_id": "みう"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 46, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好～姐姐也来给理央乖孩子乖孩子～”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5194", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 47, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“不要碰我，丑八怪。”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0563", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 48, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“什么！为什么只对美羽学姐那么亲近啊！”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5195", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 49, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我来给纱凪乖孩子乖孩子吧。”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉唷，就说摸头……不行了啦……”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 388, "voice": "_sn5196", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 51, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜～”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0646", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 52, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，熊喵也是乖孩子乖孩子～♪”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 389, "voice": "_mu3437", "char_id": "みう"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 53, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 381, "voice": "_pn0647", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 54, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“今天也这么热闹呢，哎呀熊喵，那颗球从哪里拿来的？”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 384, "voice": "_ar6668", "char_id": "愛理"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 55, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "“我给的。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "理央", "alt_speaker_idx": 385, "voice": "_ri0564", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 56, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不愧是理央央，很懂熊喵的心。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 379, "voice": "_sk5393", "char_id": "桜乃"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 57, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“女人心和熊喵小姐心，两边都是如同秋季的天空一样变幻莫测。”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "安洁", "alt_speaker_idx": 373, "voice": "_ag3993", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 58, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“可是，安洁的女仆心──”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 373, "voice": "_ag3994", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 59, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊啊真是的，大家不要只跟熊喵小姐玩，也听一下安洁说话嘛！”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "安洁", "alt_speaker_idx": 373, "voice": "_ag3995", "char_id": "アンジェ"}]}
