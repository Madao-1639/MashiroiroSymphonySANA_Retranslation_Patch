{"script": "scenario_sana_route07_07.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真正地珍惜一个女孩子，到底应该怎么做呢？", "text_idx": 330, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route07_07.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么我会有这么任性的欲望呢？", "text_idx": 331, "plain": "为什么我会有这么任性的欲望呢？", "plain_idx": 331, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
