{"script": "scenario_14.txt", "scene": "*start", "row": 91, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜、溜、呜溜～♪」", "text_idx": 447, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "pn0058", "char_id": "ぱんにゃ"}]}
