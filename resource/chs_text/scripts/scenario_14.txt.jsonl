{"script": "scenario_14.txt", "scene": "*start", "row": 44, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜♪　溜♪」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "pn0056", "char_id": "ぱんにゃ"}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我用指尖挠了挠坐在天羽学姐头上的熊喵。", "text_idx": 356, "plain": "我用指尖挠了挠坐在天羽学姐头上的熊喵。", "plain_idx": 356, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
