{"script": "scenario_14.txt", "scene": "*start", "row": 0, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生，今天樱乃不来吗？」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0484", "char_id": "愛理"}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，不知道，\\n　她平时很少事先和我说好」", "text_idx": 261, "plain": "「嗯，不知道，　她平时很少事先和我说好」", "plain_idx": 262, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
