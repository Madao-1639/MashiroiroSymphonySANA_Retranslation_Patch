{"script": "scenario_14.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然间被直呼名字……", "text_idx": 398, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 67, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「瓜生你这家伙，\\n　别再靠近美羽学姐了～～～～！」", "text_idx": 399, "plain": "「瓜生你这家伙，　别再靠近美羽学姐了～～～～！」", "plain_idx": 400, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0073", "char_id": "紗凪"}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎哎哎？！」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 69, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哼——！哼——！果然男人、男人！\\n　对你这种人温柔是错的！！」", "text_idx": 403, "plain": "「哼——！哼——！果然男人、男人！　对你这种人温柔是错的！！」", "plain_idx": 404, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0074", "char_id": "紗凪"}]}
{"script": "scenario_14.txt", "scene": "*start", "row": 70, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不要碰我的美羽学姐啊——你这个臭虫，\\n　啊当然也不要碰我」", "text_idx": 406, "plain": "「不要碰我的美羽学姐啊——你这个臭虫，　啊当然也不要碰我」", "plain_idx": 407, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0075", "char_id": "紗凪"}]}
