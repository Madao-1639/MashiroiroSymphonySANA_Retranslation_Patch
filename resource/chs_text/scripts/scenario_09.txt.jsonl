{"script": "scenario_09.txt", "scene": "*start", "row": 44, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我和小熊喵也可以一起吗？」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0108", "char_id": "みう"}]}
