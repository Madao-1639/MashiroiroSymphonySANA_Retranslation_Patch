{"script": "scenario_09.txt", "scene": "*start", "row": 84, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「不、不用顾虑我——」", "text_idx": 466, "plain": "「不、不用顾虑我——」", "plain_idx": 466, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0255", "char_id": "愛理"}]}
