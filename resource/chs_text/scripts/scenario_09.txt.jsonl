{"script": "scenario_09.txt", "scene": "*start", "row": 106, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「什么“所以”啊。\\n　不要让我说这么多遍，不用顾虑我」", "text_idx": 508, "plain": "「什么“所以”啊。　不要让我说这么多遍，不用顾虑我」", "plain_idx": 509, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0263", "char_id": "愛理"}]}
