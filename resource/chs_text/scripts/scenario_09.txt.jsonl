{"script": "scenario_09.txt", "scene": "*start", "row": 87, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵也想和小爱一起哦～？」", "text_idx": 472, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0114", "char_id": "みう"}]}
{"script": "scenario_09.txt", "scene": "*start", "row": 88, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我喜欢一个人呆着」", "text_idx": 474, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0257", "char_id": "愛理"}]}
{"script": "scenario_09.txt", "scene": "*start", "row": 89, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「不要这样说。\\n　我也想和爱理一起吃」", "text_idx": 476, "plain": "「不要这样说。　我也想和爱理一起吃」", "plain_idx": 477, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0259", "char_id": "桜乃"}]}
