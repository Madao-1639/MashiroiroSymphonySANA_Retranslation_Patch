{"script": "scenario_09.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "——在这之中。", "text_idx": 361, "plain": "——在这之中。", "plain_idx": 361, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
