{"script": "scenario_sana_route05_03.txt", "scene": "*start", "row": 90, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唔哇」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4211", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_03.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一边站起来，一边敲了下纱凪的脑袋。\\n并从附近的桌子里取出书包。", "text_idx": 343, "plain": "我一边站起来，一边敲了下纱凪的脑袋。并从附近的桌子里取出书包。", "plain_idx": 344, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
