{"script": "scenario_sana_route05_03.txt", "scene": "*start", "row": 93, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……嗯♪」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4212", "char_id": "紗凪"}]}
