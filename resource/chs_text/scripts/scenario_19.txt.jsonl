{"script": "scenario_19.txt", "scene": "*start", "row": 10, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这样啊……」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0556", "char_id": "愛理"}]}
