{"script": "scenario_19.txt", "scene": "*start", "row": 5, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「有什么问题吗？爱理同学、樱乃同学」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0285", "char_id": "アンジェ"}]}
