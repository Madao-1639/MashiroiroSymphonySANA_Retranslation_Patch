{"script": "scenario_19.txt", "scene": "*start", "row": 7, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，其他人呢？」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0555", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 8, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥去叫隼太了」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0355", "char_id": "桜乃"}]}
