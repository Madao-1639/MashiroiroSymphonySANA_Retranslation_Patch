{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈，理央真了不起啊」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 9, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「太好了……」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0555", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 10, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「乖哦乖哦，理央真了不起～」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5184", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 11, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「别摸我，丑八怪」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0556", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 12, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「为什么我夸你你就不高兴啊～！」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5185", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 13, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「小孩子和动物一样都很诚实」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0557", "char_id": "理央"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 14, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「难不成你对女人没有兴趣吗？\\n　走到那条路上去了吗？」", "text_idx": 263, "plain": "「难不成你对女人没有兴趣吗？　走到那条路上去了吗？」", "plain_idx": 264, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5186", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 15, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「理解我这种想法的可能只有万智老师这样的人而已，\\n　大部分人都——」", "text_idx": 266, "plain": "「理解我这种想法的可能只有万智老师这样的人而已，　大部分人都——」", "plain_idx": 267, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5187", "char_id": "紗凪"}]}
