{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 6, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哦，理央还会做这种事啊」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5183", "char_id": "紗凪"}]}
