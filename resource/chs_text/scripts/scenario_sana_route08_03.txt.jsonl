{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来熊喵相当喜欢那个小玩意，\\n看到我们靠过去它就把球紧紧地藏在身下。", "text_idx": 244, "plain": "看来熊喵相当喜欢那个小玩意，看到我们靠过去它就把球紧紧地藏在身下。", "plain_idx": 245, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
