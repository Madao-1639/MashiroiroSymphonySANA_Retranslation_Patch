{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 57, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「女人心和熊喵心，\\n　都如同海底针一般深不可测」", "text_idx": 357, "plain": "「女人心和熊喵心，　都如同海底针一般深不可测」", "plain_idx": 358, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ag3993", "char_id": "アンジェ"}]}
{"script": "scenario_sana_route08_03.txt", "scene": "*start", "row": 58, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「然而安洁的女仆心却——」", "text_idx": 361, "plain": "「然而安洁的女仆心却——」", "plain_idx": 361, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ag3994", "char_id": "アンジェ"}]}
