{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 42, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「喔哦，爱理要升天了……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0229", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃感觉怎么样？」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 44, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯……感觉肩膀轻松了好多」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0682", "char_id": "桜乃"}]}
