{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "下课后，我正在走廊晃悠着思考要去干什么的时候，樱乃走过来了。", "text_idx": 385, "plain": "下课后，我正在走廊晃悠着思考要去干什么的时候，樱乃走过来了。", "plain_idx": 385, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「今天一天也辛苦了」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 67, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「没问题吗？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0685", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？你指什么？」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
