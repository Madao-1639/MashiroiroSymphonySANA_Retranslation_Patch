{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "听了天羽学姐的提问后，安洁开心地跳了起来。", "text_idx": 377, "plain": "听了天羽学姐的提问后，安洁开心地跳了起来。", "plain_idx": 377, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
