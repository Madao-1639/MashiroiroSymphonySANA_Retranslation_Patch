{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在安洁说了那个爆炸性发言后很快就响了上课铃，樱乃和天羽学姐也慌忙地回去了……", "text_idx": 393, "plain": "在安洁说了那个爆炸性发言后很快就响了上课铃，樱乃和天羽学姐也慌忙地回去了……", "plain_idx": 393, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 72, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安洁确实如痴似醉的啊……」", "text_idx": 394, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 73, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你说什么……？！」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0230", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 74, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「真是的讨厌～新吾同学快不要说～了……」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0730", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 75, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「瓜生你这混蛋～～！\\n　你这混蛋，你这混蛋对安洁出手了吗～？！」", "text_idx": 399, "plain": "「瓜生你这混蛋～～！　你这混蛋，你这混蛋对安洁出手了吗～？！」", "plain_idx": 400, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0231", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安洁要是肩膀又僵硬了随时和我说哦」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 77, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「诶嘿嘿，非常感谢」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0731", "char_id": "アンジェ"}]}
