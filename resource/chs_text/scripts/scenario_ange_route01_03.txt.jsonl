{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还是第一次看到濑名同学这么开心的样子……", "text_idx": 358, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
