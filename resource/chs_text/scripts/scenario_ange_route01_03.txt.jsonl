{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 51, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「哪里哪里，这根本不算什么。倒不如说尽管放马过来吧」", "text_idx": 360, "plain": "「哪里哪里，这根本不算什么。倒不如说尽管放马过来吧」", "plain_idx": 360, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0727", "char_id": "アンジェ"}]}
