{"script": "scenario_ange_route01_03.txt", "scene": "*start", "row": 47, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「哼～哼～哼，安洁的女仆按摩大受好评真是太好了」", "text_idx": 355, "plain": "「哼～哼～哼，安洁的女仆按摩大受好评真是太好了」", "plain_idx": 355, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0726", "char_id": "アンジェ"}]}
