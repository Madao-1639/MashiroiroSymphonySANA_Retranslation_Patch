{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 74, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呜，突然这么一说，总感觉我也没什么底气了……」", "text_idx": 312, "plain": "「呜，突然这么一说，总感觉我也没什么底气了……」", "plain_idx": 312, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0825", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 75, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥，看来是本人」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0747", "char_id": "桜乃"}]}
