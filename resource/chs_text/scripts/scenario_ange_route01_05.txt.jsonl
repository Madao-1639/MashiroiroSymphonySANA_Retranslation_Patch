{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊？！」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 64, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「安洁参～上！」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0821", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不出所料。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 66, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「请问有没有需要安洁来帮忙的事情～？」", "text_idx": 298, "plain": "「请问有没有需要安洁来帮忙的事情～？」", "plain_idx": 298, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0822", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "走出玄关，安洁就在那精神满满地微笑着，吓了我一跳。", "text_idx": 300, "plain": "走出玄关，安洁就在那精神满满地微笑着，吓了我一跳。", "plain_idx": 300, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 68, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「什么都可以哦。请随便吩咐我！」", "text_idx": 301, "plain": "「什么都可以哦。请随便吩咐我！」", "plain_idx": 301, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0823", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那个啊……也就是说安洁今天在到处打听有没有需要女仆做的事情对吗……」", "text_idx": 303, "plain": "「那个啊……也就是说安洁今天在到处打听有没有需要女仆做的事情对吗……」", "plain_idx": 303, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 70, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我想到了很多奇怪的事情」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0744", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 71, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「安洁的脸以前是这样的吗？之类的……」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0745", "char_id": "桜乃"}]}
