{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯～……不太清楚啊」", "text_idx": 401, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "干劲那么足，大概是因为我才打起精神的吧……", "text_idx": 402, "plain": "干劲那么足，大概是因为我才打起精神的吧……", "plain_idx": 402, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
