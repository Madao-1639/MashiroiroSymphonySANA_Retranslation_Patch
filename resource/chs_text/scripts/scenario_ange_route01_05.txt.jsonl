{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这下就……」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "星期日我帮着樱乃叠衣服。", "text_idx": 205, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是我的手机在响吗？稍等一会儿，我还在叠衣服」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 3, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「没关系，马上就叠完了」", "text_idx": 208, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0726", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「咦？濑名同学……给我打电话还真是少见啊」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂喂？」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 6, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『喂？我是濑名……』", "text_idx": 213, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3785", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "打来电话的濑名同学，声音莫名有种紧张的感觉。", "text_idx": 216, "plain": "打来电话的濑名同学，声音莫名有种紧张的感觉。", "plain_idx": 216, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……怎么了？」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是打给樱乃而是打给我的，我感到有些疑惑。", "text_idx": 218, "plain": "不是打给樱乃而是打给我的，我感到有些疑惑。", "plain_idx": 218, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 11, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『啊、是这样……』", "text_idx": 219, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3786", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 12, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『安洁……在你那边吗？』", "text_idx": 221, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3787", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「诶？没，怎么了吗……」", "text_idx": 223, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 14, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『这样啊……那就没事了』", "text_idx": 224, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3788", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 15, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『但是小心一点』", "text_idx": 226, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3789", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……让我小心一点？", "text_idx": 228, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 17, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "『就这样，抱歉在你休息的时候打扰你了』", "text_idx": 229, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3790", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真的就只有这样，濑名同学把电话挂掉了。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 19, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理，她怎么了吗？」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0728", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好像……说让我小心安洁之类的」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 21, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0729", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 22, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「？」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0730", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「到底怎么回事啊」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 24, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「重新打过去问问」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0731", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃把我的内裤叠好放下后，也拿出了手机。", "text_idx": 241, "plain": "樱乃把我的内裤叠好放下后，也拿出了手机。", "plain_idx": 241, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 26, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哇」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0732", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就在这时，樱乃的手机也响了。", "text_idx": 244, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 28, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「是纱凪同学」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0733", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是乾同学？」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 30, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「喂喂」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0734", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 31, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……没有来我这」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0735", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃的视线朝我瞥了一眼。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……乾同学打电话过来是不是也因为安洁呢。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到、到底发生了什么？", "text_idx": 254, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我给濑名同学重新打回去吧……」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哦哇？！」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的手机又响了，这次打过来的是天羽学姐。", "text_idx": 257, "plain": "我的手机又响了，这次打过来的是天羽学姐。", "plain_idx": 257, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂……难道说又是安洁的事吗」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 39, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『哇？！瓜生为什么会知道』", "text_idx": 260, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0339", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我和樱乃刚才陆陆续续接的电话都是关于安洁的事……」", "text_idx": 262, "plain": "「我和樱乃刚才陆陆续续接的电话都是关于安洁的事……」", "plain_idx": 262, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 41, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『啊原来是这样……啊哈哈，说的也是』", "text_idx": 263, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0340", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 42, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『真是有点头痛了啊～虽然很感激』", "text_idx": 265, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0341", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……不是，我还不清楚发生了什么……」\\n（背景音：美羽~）", "text_idx": 267, "plain": "「啊……不是，我还不清楚发生了什么……」（背景音：美羽~）", "plain_idx": 268, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 44, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊、我妈妈在叫我了。瓜生拜拜，明天再见吧」", "text_idx": 269, "plain": "「啊、我妈妈在叫我了。瓜生拜拜，明天再见吧」", "plain_idx": 269, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0342", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽学姐好像以为我们也知道事情的经过，于是把电话挂掉了。", "text_idx": 272, "plain": "天羽学姐好像以为我们也知道事情的经过，于是把电话挂掉了。", "plain_idx": 272, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看向樱乃——樱乃把手机从耳边放了下来，那边的通话也好像结束了。\\n（背景音：好，再见）", "text_idx": 273, "plain": "我看向樱乃——樱乃把手机从耳边放了下来，那边的通话也好像结束了。（背景音：好，再见）", "plain_idx": 274, "len": 44, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「说什么了吗？」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 49, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「还是没太明白」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0738", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 50, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「总之安洁那边问题好像很严重的样子」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0739", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 51, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥那边呢？」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0740", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……还在说话途中就挂掉电话了……果然安洁那边发生了什么吧……真头痛」", "text_idx": 282, "plain": "「啊……还在说话途中就挂掉电话了……果然安洁那边发生了什么吧……真头痛」", "plain_idx": 282, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 53, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0741", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 55, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「？？？」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0742", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我和樱乃一同歪着头看着对方。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
