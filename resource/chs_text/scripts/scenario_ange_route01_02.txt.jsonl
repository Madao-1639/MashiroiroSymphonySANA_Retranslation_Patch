{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "午休时间和学姐、熊喵还有樱乃汇合，大家围着桌子坐在一起。", "text_idx": 437, "plain": "午休时间和学姐、熊喵还有樱乃汇合，大家围着桌子坐在一起。", "plain_idx": 437, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
