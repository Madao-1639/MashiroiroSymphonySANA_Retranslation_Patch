{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 100, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「椋梨还真是厉害啊，对吧小熊喵」", "text_idx": 461, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0314", "char_id": "みう"}]}
