{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 93, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「总之，我已经好好地向他道别了」", "text_idx": 446, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0709", "char_id": "アンジェ"}]}
