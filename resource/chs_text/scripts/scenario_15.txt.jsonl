{"script": "scenario_15.txt", "scene": "*start", "row": 0, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "10月24日。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_15.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从下周二开始，期中考试终于来临了。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
