{"script": "scenario_15.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学打开冰箱看见里面东西的瞬间，\\n发出了高亢的声音。", "text_idx": 448, "plain": "濑名同学打开冰箱看见里面东西的瞬间，发出了高亢的声音。", "plain_idx": 449, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
