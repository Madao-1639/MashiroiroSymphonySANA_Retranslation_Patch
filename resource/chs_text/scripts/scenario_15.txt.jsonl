{"script": "scenario_15.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那就先暂作休息吧。\\n　大家都辛苦了」", "text_idx": 434, "plain": "「那就先暂作休息吧。　大家都辛苦了」", "plain_idx": 435, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
