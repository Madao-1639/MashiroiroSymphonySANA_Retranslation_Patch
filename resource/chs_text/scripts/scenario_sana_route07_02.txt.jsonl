{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 85, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「就是这么一回事」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ht1784", "char_id": "隼太"}]}
