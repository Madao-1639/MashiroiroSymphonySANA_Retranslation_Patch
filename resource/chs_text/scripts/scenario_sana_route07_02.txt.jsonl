{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想我们会一直这样下去。", "text_idx": 373, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
