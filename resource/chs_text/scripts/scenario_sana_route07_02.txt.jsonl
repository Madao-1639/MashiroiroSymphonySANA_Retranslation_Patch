{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 81, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不是，因为我……\\n　说了好多新吾的坏话……但事到如今却……」", "text_idx": 338, "plain": "「不是，因为我……　说了好多新吾的坏话……但事到如今却……」", "plain_idx": 339, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4819", "char_id": "紗凪"}]}
{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 82, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ar6609", "char_id": "愛理"}]}
{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学感到很奇怪似的笑了笑，\\n轻轻捏了捏纱凪的脸。", "text_idx": 342, "plain": "濑名同学感到很奇怪似的笑了笑，轻轻捏了捏纱凪的脸。", "plain_idx": 343, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
