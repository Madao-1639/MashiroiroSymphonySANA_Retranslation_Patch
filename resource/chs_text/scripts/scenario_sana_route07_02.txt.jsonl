{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 75, "speaker": "结女校学生Ｆ", "flag": 64, "pages": [{"page": 0, "text": "「哎，我也想谈恋爱啊……\\n　想谈个轰轰烈烈的恋爱啊！」", "text_idx": 326, "plain": "「哎，我也想谈恋爱啊……　想谈个轰轰烈烈的恋爱啊！」", "plain_idx": 327, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_jx0007", "char_id": "結女生徒Ｆ"}]}
