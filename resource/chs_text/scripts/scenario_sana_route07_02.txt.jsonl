{"script": "scenario_sana_route07_02.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「最后倒是被安洁给破坏气氛了呢」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
