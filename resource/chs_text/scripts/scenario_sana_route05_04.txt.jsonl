{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 0, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「好久没和哥哥一起上学了」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5320", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好像确实」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 2, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥和其他女生好上了呢」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5321", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我没能接过樱乃的玩笑，停下了脚步。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还没有把自己和纱凪的事情告诉樱乃。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "兄妹之间需要将恋爱情况告诉对方吗？我有些拿不准。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 7, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「怎么了？」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5322", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那个，嗯」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这次是个好机会，干脆就告诉樱乃吧。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一直瞒着她也不是个办法。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「濑名同学可能和你说过了」", "text_idx": 279, "plain": "「濑名同学可能和你说过了」", "plain_idx": 279, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我其实和纱凪开始交往了」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 13, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5323", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃并没有特别惊讶。", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 15, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理知道吗？」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5324", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，纱凪好像和她说了」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 17, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……不愧是爱理。秘密保守得真好」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5325", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你没听她说过吗？」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 19, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。但我明白哥哥的心意」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5326", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 20, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「射人先射马，是这个道理吧」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5327", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎，那是什么意思……」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 22, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥，\\n　你用布偶收买了理央亲吧？」", "text_idx": 295, "plain": "「哥哥，　你用布偶收买了理央亲吧？」", "plain_idx": 296, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5328", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是，我本来没这个想法的」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过仔细一想，被她发现也挺正常的。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "毕竟理央的生日礼物是我和她一起挑的。", "text_idx": 300, "plain": "毕竟理央的生日礼物是我和她一起挑的。", "plain_idx": 300, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 26, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「理央亲开心吗？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5329", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，他好像挺喜欢那个猫猫布偶的」", "text_idx": 303, "plain": "「嗯，他好像挺喜欢那个猫猫布偶的」", "plain_idx": 303, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 28, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那就好」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5330", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「也谢谢你陪我选了礼物」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 30, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「别客气」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5331", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃笑着向前走去。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃觉得我和纱凪怎么样？」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 33, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「怎么看？」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5332", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就是说，那个……我和她在一起你会不会觉得意外？」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 35, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「没有啊。\\n　我觉得哥哥和纱凪同学很合适」", "text_idx": 314, "plain": "「没有啊。　我觉得哥哥和纱凪同学很合适」", "plain_idx": 315, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5333", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是吗？」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 37, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。大家知道你们在一起了吗？」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5334", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没，应该只有你、濑名同学还有隼太知道」", "text_idx": 320, "plain": "「没，应该只有你、濑名同学还有隼太知道」", "plain_idx": 320, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「在班里我也想暂时保密」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 40, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……我喜欢这样」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5335", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喜欢什么？」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 42, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「喜欢这种不可告人的秘密关系」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5336", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 43, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「有点向往」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5337", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不过，\\n　我感觉还是那种能告诉大家，得到大家祝福的关系是最好的」", "text_idx": 329, "plain": "「不过，　我感觉还是那种能告诉大家，得到大家祝福的关系是最好的」", "plain_idx": 330, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 45, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5338", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 46, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「是啊」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5339", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 47, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那种关系才是最好的」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5340", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「咦？樱乃，你不去自己的教室吗？」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 49, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我找爱理有话要说」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5341", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是么。濑名同学有没有到啊……」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说完，我们俩朝教室内望去。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 52, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「臭～虫～♪」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4218", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「等下？！」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪微笑着跑来，\\n我急忙拽着她的胳膊走出了教室。", "text_idx": 345, "plain": "纱凪微笑着跑来，我急忙拽着她的胳膊走出了教室。", "plain_idx": 346, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 55, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥，你真的打算保密吗？」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5342", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「刚才那个，当作没听见吧」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 57, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「怎、怎么了？\\n　我做了什么坏事吗？」", "text_idx": 350, "plain": "「怎、怎么了？　我做了什么坏事吗？」", "plain_idx": 351, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4219", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你说什么坏事，\\n　为什么要那么开心地叫我臭虫啊？」", "text_idx": 353, "plain": "「你说什么坏事，　为什么要那么开心地叫我臭虫啊？」", "plain_idx": 354, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你那么张扬，咱俩的关系保密起来不就没什么意义了么」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 60, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……我刚才有那么开心吗？」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4220", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，你觉得呢？」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 62, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「太明显了」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5343", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 63, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「啊，真的吗？！\\n　话说回来，小樱也知道咱俩的事情啊？」", "text_idx": 361, "plain": "「啊，真的吗？！　话说回来，小樱也知道咱俩的事情啊？」", "plain_idx": 362, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4221", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。我今天早上和樱乃说了」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 65, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……这样啊，感觉有点害羞」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4222", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 66, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我哥哥就拜托你了，嫂子」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5344", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 67, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「嫂、嫂子？」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4223", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，你那称呼有点太早了」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 69, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我这妹妹改口太快了，对不起」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5345", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 70, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「没事，挺好的，叫嫂子挺好的！」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4224", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……纱凪，咱俩这真的是要隐藏关系吗？」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「啊，对哦。\\n　呃，新吾是臭虫，新吾是臭虫……」", "text_idx": 377, "plain": "「啊，对哦。　呃，新吾是臭虫，新吾是臭虫……」", "plain_idx": 378, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4225", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我倒是觉得你没必要拘泥于这个称呼」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 74, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥真是个无可救药的臭虫」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5346", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 75, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「大概这个感觉？」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5347", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 76, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……小樱，太厉害了」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4226", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「被这么叫了，哥哥该是什么表情呢？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 78, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「请表现得高兴一点」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sk5348", "char_id": "桜乃"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我却无法坦然接受。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 80, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「别看这里，臭虫」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0353", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 81, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哦哦哦，这就是正宗的臭虫……！」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4227", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我感觉这没什么好赞叹的吧」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放学后，理央来活动室玩了。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 84, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「美羽羽，我可以给熊喵喂罐头吗？」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0354", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 85, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯。那就麻烦你咯？」", "text_idx": 400, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3298", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 86, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「谢谢。熊喵，来」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0355", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 87, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜～♪」", "text_idx": 405, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_pn0614", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 88, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呵呵呵。小熊喵，\\n　和理央的关系已经这么好了」", "text_idx": 407, "plain": "「呵呵呵。小熊喵，　和理央的关系已经这么好了」", "plain_idx": 408, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3299", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 89, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「感觉它和你比我还亲，心情复杂……」", "text_idx": 410, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4228", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 90, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「熊喵是雌性，所以更喜欢男生么？」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4229", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 91, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「这是人性的问题」", "text_idx": 414, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0356", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 92, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜——溜——♪」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_pn0615", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 93, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「理央，开罐头的时候小心别割到手指」", "text_idx": 418, "plain": "「理央，开罐头的时候小心别割到手指」", "plain_idx": 418, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3300", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 94, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「没事的。就开个罐头，我也……」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0357", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 95, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「唔啊？！」", "text_idx": 422, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0358", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 96, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「傻瓜，你干什么呢！」", "text_idx": 424, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4230", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "罐头从理央手中滑落，\\n里面的食物洒了一地。", "text_idx": 426, "plain": "罐头从理央手中滑落，里面的食物洒了一地。", "plain_idx": 427, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "估计是拉罐头拉环的时候用力过猛了。", "text_idx": 428, "plain": "估计是拉罐头拉环的时候用力过猛了。", "plain_idx": 428, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「理央，没事吧？」", "text_idx": 429, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 100, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「没受伤吧？」", "text_idx": 430, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3301", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 101, "speaker": "理央", "flag": 64, "pages": [{"page": 0, "text": "「……嗯。但是，对不起」", "text_idx": 432, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_ri0359", "char_id": "理央"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 102, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「没事，别放在心上。\\n　我开罐头也经常失败呢～」", "text_idx": 434, "plain": "「没事，别放在心上。　我开罐头也经常失败呢～」", "plain_idx": 435, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3302", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐笑着摸了摸理央的脑袋，\\n开始收拾起洒出的食物。", "text_idx": 437, "plain": "学姐笑着摸了摸理央的脑袋，开始收拾起洒出的食物。", "plain_idx": 438, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 104, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐，我来收拾吧」", "text_idx": 439, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4231", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 105, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊，这个没关系的。\\n　纱纱你也别生理央的气哦？」", "text_idx": 441, "plain": "「啊，这个没关系的。　纱纱你也别生理央的气哦？」", "plain_idx": 442, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3303", "char_id": "みう"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 106, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4232", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说着说着，纱凪的表情阴沉了下来。", "text_idx": 445, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 108, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉。我去做外面的工作了」", "text_idx": 446, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4233", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我也去外面」", "text_idx": 448, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不能丢下纱凪不管，便跟着她走了出去。", "text_idx": 449, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 111, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4234", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「从哪里开始呢」", "text_idx": 451, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我没敢仔细询问纱凪，只是望了望旁边的兔子笼。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想缓和下气氛，让纱凪能自己说出原委。", "text_idx": 453, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 115, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你是来追我的吗？」", "text_idx": 454, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4235", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 116, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不过我表面上说的是来外面干活」", "text_idx": 456, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 117, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……谢谢」", "text_idx": 457, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4236", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「发生了什么你在意的事情吗？」", "text_idx": 459, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 119, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4237", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪不掩情绪地低下头，望着脚下。", "text_idx": 461, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 121, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唉，果然是美羽学姐啊……」", "text_idx": 462, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4238", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐？」", "text_idx": 464, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 123, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「嗯。理央最近天天在家里聊到学姐……」", "text_idx": 465, "plain": "「嗯。理央最近天天在家里聊到学姐……」", "plain_idx": 465, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4239", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 124, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「有种弟弟被抢走的感觉」", "text_idx": 467, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4240", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 125, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪露出神情复杂的笑容，背过身去。", "text_idx": 469, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 126, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……迟早，连新吾你也……」", "text_idx": 470, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4241", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 127, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 128, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「说着玩的♪刚才都是在开玩笑哦」", "text_idx": 472, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4242", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道」", "text_idx": 474, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪立刻否定了自己，\\n我意识到这一点后就没再追问。", "text_idx": 475, "plain": "纱凪立刻否定了自己，我意识到这一点后就没再追问。", "plain_idx": 476, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 131, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，再过不久就圣诞节了啊……」", "text_idx": 477, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4243", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 132, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不愧是叫“师走”，\\n　十二月过去得可真快」\\n　（注：师走为日语中十二月的别称）", "text_idx": 479, "plain": "「不愧是叫“师走”，　十二月过去得可真快」　（注：师走为日语中十二月的别称）", "plain_idx": 480, "len": 42, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4244", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 133, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪主动转移了话题，走到我身边。", "text_idx": 482, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 134, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "与刚才不同，她这次笑得很自然。", "text_idx": 483, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「给理央的礼物买好了吗？」", "text_idx": 484, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 136, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「还没有。\\n　我每年都会纠结圣诞礼物啊～……」", "text_idx": 485, "plain": "「还没有。　我每年都会纠结圣诞礼物啊～……」", "plain_idx": 486, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4245", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 137, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那今年要不要一起买？」", "text_idx": 488, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 138, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「真的吗？你要陪我买东西吗？」", "text_idx": 489, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4246", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「当然。理央那个年龄，\\n　应该很期待圣诞老人拜访吧」", "text_idx": 491, "plain": "「当然。理央那个年龄，　应该很期待圣诞老人拜访吧」", "plain_idx": 492, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 140, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唔……那个啊，\\n　那孩子其实不相信有圣诞老人存在的」", "text_idx": 493, "plain": "「唔……那个啊，　那孩子其实不相信有圣诞老人存在的」", "plain_idx": 494, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4247", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 141, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「明明还是个小孩子，真不知道该说他是没有梦想还是太现实了……」", "text_idx": 496, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4248", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 142, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那今年就让我来当圣诞老人吧」", "text_idx": 498, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以，下个假期\\n　要不要一起去买礼物？」", "text_idx": 499, "plain": "「所以，下个假期　要不要一起去买礼物？」", "plain_idx": 500, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 144, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……原来如此，还有送礼物这一招」", "text_idx": 501, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4249", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么了？」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 146, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「仔细一想，小孩子的心是可以用金钱买到的」", "text_idx": 503, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4250", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 147, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「今年就买个豪华的礼物，\\n　然后就等他说些“最喜欢姐姐了～”之类的话」", "text_idx": 505, "plain": "「今年就买个豪华的礼物，　然后就等他说些“最喜欢姐姐了～”之类的话」", "plain_idx": 506, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4251", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 148, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「呵呵呵，去买个装不进袜子里的\\n　超棒的礼物吧～♪」", "text_idx": 508, "plain": "「呵呵呵，去买个装不进袜子里的　超棒的礼物吧～♪」", "plain_idx": 509, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4252", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她能恢复精神比什么都好。", "text_idx": 511, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_04.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但是金钱真的能买到小孩子的心么。", "text_idx": 512, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
