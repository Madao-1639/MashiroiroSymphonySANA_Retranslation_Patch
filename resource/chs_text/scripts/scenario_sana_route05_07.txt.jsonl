{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『对不起，纱凪。可以和我分手吗』", "text_idx": 144, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 1, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『哎……』", "text_idx": 146, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4335", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『我喜欢上了其他人。\\n　她也说她喜欢我』", "text_idx": 148, "plain": "『我喜欢上了其他人。　她也说她喜欢我』", "plain_idx": 149, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 3, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『……她……是我认识的人吗？』", "text_idx": 150, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4336", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『…………』", "text_idx": 152, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 5, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『新吾，在和谁聊天呢？』", "text_idx": 154, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3310", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 6, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『？！』", "text_idx": 156, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4337", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 7, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『啊，是纱纱啊。在聊什么呢？』", "text_idx": 158, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3311", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『在谈分手。我想着和美羽学姐在一起之前，\\n　要把之前的关系好好清算一下』", "text_idx": 160, "plain": "『在谈分手。我想着和美羽学姐在一起之前，　要把之前的关系好好清算一下』", "plain_idx": 161, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 9, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『这样啊。纱纱，对不起啊。\\n　我把新吾抢走了……』", "text_idx": 162, "plain": "『这样啊。纱纱，对不起啊。　我把新吾抢走了……』", "plain_idx": 163, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3312", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『才不是这样的。是我选择了美羽学姐』", "text_idx": 165, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 11, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『……你难道，是和美羽学姐在一起了？』", "text_idx": 166, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4338", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『嗯，美羽学姐果然还是特别的』", "text_idx": 168, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『怎么说呢，年龄大一些的女性真棒啊。\\n　既没有孩子气，而且还很包容』", "text_idx": 169, "plain": "『怎么说呢，年龄大一些的女性真棒啊。　既没有孩子气，而且还很包容』", "plain_idx": 170, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『她让我明白了，\\n　我以前根本不知道什么是真正的女性』", "text_idx": 171, "plain": "『她让我明白了，　我以前根本不知道什么是真正的女性』", "plain_idx": 172, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 15, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『…………』", "text_idx": 152, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4339", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 16, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『对不起呀，纱纱。\\n　我会让新吾幸福的……』", "text_idx": 174, "plain": "『对不起呀，纱纱。　我会让新吾幸福的……』", "plain_idx": 175, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3313", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『纱凪，你也忘掉我，去寻找幸福吧』", "text_idx": 177, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 18, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『等、等一下』", "text_idx": 178, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4340", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 19, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『纱纱也要和另一个人一起变得幸福哦，拜拜』", "text_idx": 180, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_mu3314", "char_id": "みう"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "『拜拜，纱凪』", "text_idx": 182, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 21, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "『不要，我不要这样。新吾，不要走。\\n　不要抛弃我』", "text_idx": 183, "plain": "『不要，我不要这样。新吾，不要走。　不要抛弃我』", "plain_idx": 184, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4341", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我从早晨开始就一直很忧郁。", "text_idx": 186, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从噩梦中醒来。", "text_idx": 187, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "起床后发现枕头被眼泪浸湿了。", "text_idx": 188, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我为什么会这么不安呢。", "text_idx": 189, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐在我脑中挥之不去。", "text_idx": 190, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而更多的是，我无法停止思考新吾的事情。", "text_idx": 191, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「今天这是怎么了，一大早就没什么精神」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 29, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……你怎么看出来的？」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4342", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因为我一直都在注意你啊」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 31, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4343", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明他这么关心我。", "text_idx": 198, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我却做了那种梦，自己真是差劲。", "text_idx": 199, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这么一想后，我就不再敢看向新吾的脸了。", "text_idx": 200, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「还在想出轨的事？」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 36, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不是的……不过我确实是在思考你的事。\\n　从早上开始就一直在想你」", "text_idx": 202, "plain": "「不是的……不过我确实是在思考你的事。　从早上开始就一直在想你」", "plain_idx": 203, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4344", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那就和我一样了」", "text_idx": 205, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 38, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4345", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也是从早上开始就一直在想你的事」", "text_idx": 208, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「都没心思专心学习了，可给我纠结坏了」", "text_idx": 209, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾不好意思地笑了笑，握住了我的手。", "text_idx": 210, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他的举动让我稍稍安心了一些。", "text_idx": 211, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他要是不这样亲近我，我就安心不下来。", "text_idx": 212, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 44, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……新吾啊」", "text_idx": 213, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4346", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还想要更加安心。", "text_idx": 216, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "仅仅是对话还不够，\\n手牵着手我也无法满足。", "text_idx": 217, "plain": "仅仅是对话还不够，手牵着手我也无法满足。", "plain_idx": 218, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 48, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你……接过吻吗……？」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4347", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我向新吾提出了无比大胆的问题。", "text_idx": 221, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "脸颊一瞬间变得滚烫。", "text_idx": 222, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看着新吾的嘴唇，不由自主浮想联翩起来。", "text_idx": 223, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没有过」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 53, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我、我也……没有……接过吻……」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4348", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在和新吾交往之前，我甚至都没有想过要接吻。", "text_idx": 227, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，现在……", "text_idx": 228, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我稍微，有了些兴趣。", "text_idx": 229, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果新吾能夺过我的嘴唇，\\n我是不是就能更安心些了呢。", "text_idx": 230, "plain": "如果新吾能夺过我的嘴唇，我是不是就能更安心些了呢。", "plain_idx": 231, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我是不是就不会再做那样的梦了呢。", "text_idx": 232, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾露出了认真的表情。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我知道，他那是开始在意我了。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我……如果……你想接吻……」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4349", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我自己做不到主动，所以想让他来迈出这一步。", "text_idx": 237, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我越来越不敢看向新吾的脸，\\n胸口像是破了个洞一样呼吸困难。", "text_idx": 238, "plain": "我越来越不敢看向新吾的脸，胸口像是破了个洞一样呼吸困难。", "plain_idx": 239, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「现在还不行」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 66, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哎……」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4350", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「看到你那样颤抖着等待，\\n　我现在吻不下去」", "text_idx": 243, "plain": "「看到你那样颤抖着等待，　我现在吻不下去」", "plain_idx": 244, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 68, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4351", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他温柔地抚摸着我的脑袋，泪水渐渐盈满了我的眼眶。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「而且」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你今天给我的感觉有些不太一样」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「？！」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4352", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不过也可能是我的错觉吧」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我什么话都没说。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾大概是看穿了我的心思。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他看出来了，我并不是因为喜欢他所以才想要接吻。", "text_idx": 254, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我只是，为了让自己感到安心，所以才想和他接吻。", "text_idx": 255, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想要以这种不堪的理由，\\n来促成我们这仅此一次的初吻。", "text_idx": 256, "plain": "我想要以这种不堪的理由，来促成我们这仅此一次的初吻。", "plain_idx": 257, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 79, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……对不起。我净说些奇怪的话」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4353", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾的温柔缓缓浸入我心间，泪水不由得夺眶而出。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 81, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「呜、等一下。我转过去一会儿」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4354", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 83, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4355", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但我在转身的途中就被新吾搂住肩膀，\\n他的脸随后凑到了我眼前。", "text_idx": 265, "plain": "但我在转身的途中就被新吾搂住肩膀，他的脸随后凑到了我眼前。", "plain_idx": 266, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我赶紧闭上了眼睛。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我做好心理准备，绷紧嘴唇。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 87, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「嗯……啊……」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4356", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "脸颊上传来轻柔的触感。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我被新吾顺势抱在了怀里。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「抱歉，吓到你了吗？」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 91, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……没有」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4357", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "仅仅是脸颊上被轻轻一吻，\\n我的脑中便变得一片空白。", "text_idx": 276, "plain": "仅仅是脸颊上被轻轻一吻，我的脑中便变得一片空白。", "plain_idx": 277, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知什么时候，我停止了颤抖。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是身子软绵绵的，脚下站不太稳。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 95, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「明明只是亲了一下脸……」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn4358", "char_id": "紗凪"}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我就已经再说不出任何感想了。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被他嘴唇碰到的地方一直在发烫，\\n那股触感迟迟没有消失。", "text_idx": 283, "plain": "被他嘴唇碰到的地方一直在发烫，那股触感迟迟没有消失。", "plain_idx": 284, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果刚刚亲的是嘴……？", "text_idx": 285, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我仅是想象都觉得害怕。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "早晨做的梦早已被我抛到脑后。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route05_07.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我在新吾的臂弯中，来到了另一个梦境世界……", "text_idx": 288, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
