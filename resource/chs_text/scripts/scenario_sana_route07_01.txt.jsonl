{"script": "scenario_sana_route07_01.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那么，再来一次」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
