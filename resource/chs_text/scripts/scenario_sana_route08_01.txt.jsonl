{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 116, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你看，又开始闹脾气了——」", "text_idx": 491, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5089", "char_id": "紗凪"}]}
