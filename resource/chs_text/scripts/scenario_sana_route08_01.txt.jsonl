{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪有些害羞地笑了笑，\\n朝我抱了过来。", "text_idx": 527, "plain": "纱凪有些害羞地笑了笑，朝我抱了过来。", "plain_idx": 528, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
