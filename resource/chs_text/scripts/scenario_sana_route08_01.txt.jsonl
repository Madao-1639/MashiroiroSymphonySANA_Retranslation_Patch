{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 111, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜？！」", "text_idx": 482, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_pn0638", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 112, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唉，理央真会家里横啊」", "text_idx": 484, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5087", "char_id": "紗凪"}]}
