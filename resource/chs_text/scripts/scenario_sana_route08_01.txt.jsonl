{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「对了，\\n　还没有决定下任社团长是谁吧？」", "text_idx": 470, "plain": "「对了，　还没有决定下任社团长是谁吧？」", "plain_idx": 471, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
