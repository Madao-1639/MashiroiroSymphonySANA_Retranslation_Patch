{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 121, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜……」", "text_idx": 500, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_pn0639", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪关上了门，\\n有些担心地叹了口气。", "text_idx": 502, "plain": "纱凪关上了门，有些担心地叹了口气。", "plain_idx": 503, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我从身后抱住了她。", "text_idx": 504, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 124, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「新吾这样也太狡猾了……」", "text_idx": 505, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5092", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 507, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 126, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「每次我希望你抱住我的时候，\\n　你都会这样做」", "text_idx": 508, "plain": "「每次我希望你抱住我的时候，　你都会这样做」", "plain_idx": 509, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5093", "char_id": "紗凪"}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 127, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「为什么新吾会明白我想要什么呢？」", "text_idx": 511, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5094", "char_id": "紗凪"}]}
