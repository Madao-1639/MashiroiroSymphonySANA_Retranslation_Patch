{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 139, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「难不成被我的胸这样顶着，\\n　会想做那种事吗？」", "text_idx": 533, "plain": "「难不成被我的胸这样顶着，　会想做那种事吗？」", "plain_idx": 534, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn7533", "char_id": "紗凪"}]}
