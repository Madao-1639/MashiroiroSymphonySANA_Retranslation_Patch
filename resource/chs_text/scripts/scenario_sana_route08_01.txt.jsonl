{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 108, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜～♪」", "text_idx": 475, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_pn0637", "char_id": "ぱんにゃ"}]}
{"script": "scenario_sana_route08_01.txt", "scene": "*start", "row": 109, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「理央还是小学生吧。\\n　你真的能交到朋友吗～？」", "text_idx": 477, "plain": "「理央还是小学生吧。　你真的能交到朋友吗～？」", "plain_idx": 478, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "_sn5086", "char_id": "紗凪"}]}
