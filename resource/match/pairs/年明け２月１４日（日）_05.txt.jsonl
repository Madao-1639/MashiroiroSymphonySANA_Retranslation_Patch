{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 49, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "说着，纱凪从旁边顶了顶我。", "steam": "纱凪从旁边撞我。"}, "length": {"chs": 13, "steam": 8}, "similarity": 0.667}
