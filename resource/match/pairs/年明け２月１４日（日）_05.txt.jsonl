{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 61, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "我紧紧地抱住了她。", "steam": "我抱住她。"}, "length": {"chs": 9, "steam": 5}, "similarity": 0.667}
