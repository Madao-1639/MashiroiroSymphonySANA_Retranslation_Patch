{"script": "１２月２４日（木）_03.txt", "scene": "*start", "row": 44, "page": 0, "status": "aligned", "speaker": {"chs": "纱凪", "steam": "紗凪"}, "alt_speaker": {"chs": null, "steam": "纱凪"}, "voice": {"chs": "sn6784", "steam": "sn6784", "equal": true}, "text": {"chs": "「这、这种说法，也不错呢……再说点……」", "steam": "“那、那样说也、那个、很好……还要听……”"}, "length": {"chs": 20, "steam": 21}, "similarity": 0.214}
