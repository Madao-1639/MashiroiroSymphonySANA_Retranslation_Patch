{"script": "１２月２４日（木）_03.txt", "scene": "*start", "row": 52, "page": 0, "status": "aligned", "speaker": {"chs": "纱凪", "steam": "紗凪"}, "alt_speaker": {"chs": null, "steam": "纱凪"}, "voice": {"chs": "sn6788", "steam": "sn6788", "equal": true}, "text": {"chs": "「我睡我睡我睡！\\n　你会、会和我一起睡吧？！」", "steam": "“睡睡睡！一、一起睡觉对吧！？”"}, "length": {"chs": 24, "steam": 16}, "similarity": 0.552}
