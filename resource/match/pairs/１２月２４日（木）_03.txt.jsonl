{"script": "１２月２４日（木）_03.txt", "scene": "*start", "row": 54, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "嗯，没事的。\\n我现在能忍住。", "steam": "嗯，没问题。我能忍得住。"}, "length": {"chs": 15, "steam": 12}, "similarity": 0.571}
{"script": "１２月２４日（木）_03.txt", "scene": "*start", "row": 55, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "不会再次失去理智了。", "steam": "不会再失去理性了。"}, "length": {"chs": 10, "steam": 9}, "similarity": 0.824}
