{"script": "１２月２４日（木）_03.txt", "scene": "*start", "row": 62, "page": 0, "status": "needs_review", "speaker": {"chs": "新吾", "steam": "新吾"}, "alt_speaker": {"chs": null, "steam": "新吾"}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "「你真的有打算睡觉吗？」", "steam": "“你根本就不想睡吧？”"}, "length": {"chs": 12, "steam": 11}, "similarity": 0.235}
