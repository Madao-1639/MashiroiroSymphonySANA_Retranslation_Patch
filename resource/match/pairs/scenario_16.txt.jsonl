{"script": "scenario_16.txt", "scene": "*start", "row": 6, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "她平时总是在煽动学生，\\n但是今天……感觉没那个兴致？", "steam": "平时总是煽动学生情绪的学园长，今天……好像有点不一样？"}, "length": {"chs": 27, "steam": 27}, "similarity": 0.435}
